{{ define "page/topology" }}
{{- template "layout/head" . }}

{{- if not .Layout }}
<section class="block">
    <div class="card empty">
        <p>No topology recorded yet. It appears when Jocasta reads the ports of
            a MikroTik or OpenWrt router.</p>
        <p>To set it up, see <a href="https://github.com/pushkar-anand/jocasta/blob/main/docs/plugins/topology.md">Show what is plugged in where</a>.</p>
    </div>
</section>
{{- else }}
<section class="block">
    {{- /* The search is outside the part that the poll swaps. So the typed text
           stays after each redraw. netmap.js applies it to the new tree. */}}
    <div class="netmap-wrap">
        <label class="netmap__search">
            <span class="visually-hidden">Find a device, switch or access point</span>
            <input id="netmap-search" type="search" placeholder="Search" autocomplete="off" spellcheck="false">
        </label>
        <div id="map-live" hx-get="/topology/live" hx-trigger="every 60s" hx-swap="innerHTML">
            {{- template "partial/topology-body" . }}
        </div>
    </div>
</section>
{{- end }}

{{- template "layout/foot" . }}
{{ end }}
