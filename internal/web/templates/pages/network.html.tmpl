{{ define "page/network" }}
{{- template "layout/head" . }}

{{- with .OnNetwork }}
<section class="block">
    <h2 class="section">Network</h2>
    <div class="card panel">
        {{- /* Lead with what a person calls this segment when a source has named
               it; the CIDR is the address of it, one line down. An unnamed
               prefix has only its CIDR, so that leads instead. */}}
        <p class="netcard__top">
            {{- if .Name }}
            <span class="nethead__name">{{ .Name }}</span>
            {{- else }}
            <span class="nethead__name mono">{{ .CIDR }}</span>
            {{- end }}
            {{- if .VLAN }}
            <span class="chip chip--brand">VLAN {{ .VLAN }}</span>
            {{- end }}
        </p>
        {{- if .Name }}
        <p class="nethead__cidr mono">{{ .CIDR }}</p>
        {{- end }}

        <svg class="ledger" viewBox="0 0 100 10" preserveAspectRatio="none" role="img"
             aria-label="{{ .Online }} of {{ .Total }} devices seen recently">
            <rect class="ledger__track" x="0" y="0" width="100" height="10"></rect>
            <rect class="ledger__online" x="0" y="0"
                  width="{{ pct .Online .Total }}" height="10"></rect>
            <rect class="ledger__offline" x="{{ pct .Online .Total }}" y="0"
                  width="{{ pct .Offline .Total }}" height="10"></rect>
        </svg>

        <ul class="legend">
            <li><span class="dot dot--ok" aria-hidden="true"></span>Seen recently <strong>{{ .Online }}</strong></li>
            <li><span class="dot dot--warn" aria-hidden="true"></span>Quiet <strong>{{ .Offline }}</strong></li>
            <li><span class="dot dot--quiet" aria-hidden="true"></span>On this network <strong>{{ .Total }}</strong></li>
        </ul>
        {{- with $.Window }}
        <p class="note">&ldquo;Seen recently&rdquo; counts devices that answered a sweep in the last {{ . }}.</p>
        {{- end }}
    </div>
</section>
{{- end }}

<section class="block">
    <div class="block__head">
        <h2 class="section">Devices</h2>
    </div>

    {{ template "partial/device-filters" . }}
    {{ template "partial/device-rows" . }}
</section>

{{- template "layout/foot" . }}
{{ end }}
