{{ define "page/device" }}
{{- template "layout/head" . }}

{{ template "partial/device-panel" . }}

{{- with .Connection }}
<section class="block">
    <h2 class="section">Connected</h2>
    <div class="card panel">
        {{- if .Placed }}
        <ol class="path" aria-label="Path from the internet to this device">
            <li class="path__hop">Internet</li>
            {{- range .Hops }}
            <li class="path__hop">
                {{- with .Via }}<span class="chip">{{ . }}</span>{{ end }}
                {{- if .DeviceID }}<a href="/devices/{{ .DeviceID }}">{{ .Name }}</a>{{ else }}<span>{{ .Name }}</span>{{ end }}
            </li>
            {{- end }}
            <li class="path__hop path__hop--here">
                {{- with .Last }}<span class="chip chip--brand">{{ . }}</span>{{ end }}
                <strong>{{ $.Device.Name }}</strong>
                {{- with .Speed }}<span class="chip">{{ . }}</span>{{ end }}
                {{- if not .Current }}<span class="chip">last seen here</span>{{ end }}
            </li>
        </ol>
        {{- with .Capable }}
        <p class="path__more">Both ends can run at {{ . }}, and this link runs slower. Try another cable, or reseat this one at both ends.</p>
        {{- end }}
        <p class="path__more"><a href="/topology?focus={{ .Focus }}">Show on topology</a></p>
        {{- else }}
        <p class="dim">No router, switch or access point has seen this device on a port.</p>
        {{- end }}
    </div>
</section>
{{- end }}

{{- with .Device }}
<section class="block">
    <h2 class="section">Addresses</h2>
    <div class="card card--table">
        <div class="scroller">
            <table>
                <thead>
                <tr>
                    <th scope="col">Address</th>
                    <th scope="col">Network</th>
                    <th scope="col">Held</th>
                    <th scope="col">First seen</th>
                    <th scope="col">Last seen</th>
                </tr>
                </thead>
                <tbody>
                {{- range .Addresses }}
                <tr>
                    <td>
                        <span class="cell">
                            {{ dot .LastSeen }}
                            <span class="mono strong">{{ .IP }}</span>
                        </span>
                    </td>
                    <td>
                        {{- with .Network }}
                        <span class="cell">
                            <a class="mono" href="/networks/{{ .ID }}">{{ .CIDR }}</a>
                            {{- if .VLAN }}
                            <span class="chip chip--brand">VLAN {{ .VLAN }}</span>
                            {{- end }}
                        </span>
                        {{- else }}
                        <span class="dim">&mdash;</span>
                        {{- end }}
                    </td>
                    <td>
                        {{- if .Current }}
                        <span class="chip chip--ok">now</span>
                        {{- else }}
                        <span class="chip">released</span>
                        {{- end }}
                    </td>
                    <td class="dim">{{ stamp .FirstSeen "" }}</td>
                    <td class="dim">{{ stamp .LastSeen "" }}</td>
                </tr>
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
</section>
{{- end }}

<section class="block">
    <h2 class="section">Ports</h2>
    {{- if .Ports }}
    {{- template "partial/device-ports" .Ports }}
    {{- if not .PortScanConfigured }}
    <p class="dim">Port scanning is not configured, so only the services this device advertises are listed. Set <code>scan.ports.enabled: true</code>, or run <code>jocasta ports --save</code>.</p>
    {{- end }}
    {{- else if .PortScanConfigured }}
    <p class="dim">No open ports found on this device.</p>
    {{- else }}
    <p class="dim">Port scanning is not configured, so the services on this device are unknown. Set <code>scan.ports.enabled: true</code>, or run <code>jocasta ports --save</code>.</p>
    {{- end }}
</section>

<section class="block" id="traffic">
    <h2 class="section">Talks to</h2>
    {{- template "partial/device-traffic" .Traffic }}
</section>

{{- if .Claims }}
<section class="block">
    <h2 class="section">Sources</h2>
    {{- template "partial/device-sources" .Claims }}
</section>
{{- end }}

<section class="block">
    <div class="block__head">
        <h2 class="section">History</h2>
        {{- /* The page shows the most recent handful; the full log for this
               device, paged, is the change log narrowed to it. */}}
        <a class="more" href="/events?device={{ .Device.ID }}">Full history
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </a>
    </div>
    <div id="device-history">
        {{- template "partial/activity" .Events }}
    </div>
</section>

{{- template "layout/foot" . }}
{{ end }}
