{{ define "page/scans" }}
{{- template "layout/head" . }}

<section class="block">
    <div class="block__head block__head--end">
        <p class="block__aside">Scheduled by <code>jocasta serve</code>, or run with <code>jocasta scan</code></p>
    </div>

    {{- /* Discovery sweeps and port scans share this log; the filter is how you
           read one without the other. */}}
    <nav class="logfilter" aria-label="Filter scans by kind">
        <a href="/scans"{{ if not .Kind }} aria-current="page"{{ end }}>All</a>
        <a href="/scans?kind=discovery"{{ if eq .Kind "discovery" }} aria-current="page"{{ end }}>Discovery</a>
        <a href="/scans?kind=ports"{{ if eq .Kind "ports" }} aria-current="page"{{ end }}>Ports</a>
        <a href="/scans?kind=import"{{ if eq .Kind "import" }} aria-current="page"{{ end }}>Import</a>
    </nav>

    {{- if .Scans }}
    <div class="card card--table">
        <div class="scroller">
            <table class="stacks">
                <thead>
                <tr>
                    <th scope="col">Started</th>
                    <th scope="col">Kind</th>
                    <th scope="col">Source</th>
                    <th scope="col">Network</th>
                    <th scope="col">Found</th>
                    <th scope="col">Took</th>
                    <th scope="col">Status</th>
                </tr>
                </thead>
                <tbody>
                {{- range .Scans }}
                <tr>
                    <td class="dim">{{ stamp .StartedAt "" }}</td>
                    <td data-label="Kind" class="lower">{{ .Kind }}</td>
                    <td data-label="Source" class="strong">{{ .Source }}</td>
                    <td data-label="Network" class="mono">{{ dash .Network }}</td>
                    <td data-label="Found">{{ found . }}</td>
                    <td data-label="Took" class="dim num">{{ took . }}</td>
                    <td data-label="Status"><span class="{{ statusClass .Status }}">{{ .Status }}</span></td>
                </tr>
                {{- with .Error }}
                <tr class="row--note">
                    <td colspan="7"><p class="failure">{{ . }}</p></td>
                </tr>
                {{- end }}
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
    {{- else if .Kind }}
    <div class="card empty">
        <p>No {{ if eq .Kind "discovery" }}discovery sweeps{{ else if eq .Kind "ports" }}port scans{{ else }}imports{{ end }} recorded yet.</p>
    </div>
    {{- else }}
    <div class="card empty">
        <p>No scans recorded yet. <code>jocasta serve</code> runs them on a schedule, and
            <code>jocasta scan</code> runs one now.</p>
    </div>
    {{- end }}
    {{ template "partial/pager" . }}
</section>

{{- template "layout/foot" . }}
{{ end }}
