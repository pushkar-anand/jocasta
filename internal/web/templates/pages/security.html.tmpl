{{ define "page/security" }}
    {{- template "layout/head" . }}

    <section class="block">
        <div class="block__head">
            <h2 class="section">Security</h2>
        </div>

        <p class="note">Signing in as {{ .SignedInAs }} can ask for a code from your phone
            as well as your password.</p>

        {{- with .RecoveryCodes }}
            <div class="tokenreveal">
                <p class="tokenreveal__label">Recovery codes</p>
                <p class="tokenreveal__hint">Save these now. They will not be shown again. If you lose your
                    phone, each code signs you in once in place of an app code.</p>

                <pre class="reccodes" id="recovery-codes">{{ range . }}{{ . }}
{{ end -}}</pre>

                <div class="reccodes__actions">
                    <button type="button" class="btn btn--quiet btn--sm" data-copy="#recovery-codes">Copy all</button>
                    <button type="button" class="btn btn--quiet btn--sm" data-download="#recovery-codes"
                            data-filename="jocasta-recovery-codes.txt">Download as text</button>
                </div>
            </div>
        {{- end }}

        <div class="card panel">
            {{- if .Enrolling }}
                <p>Scan this code with your authenticator app, then enter the
                    6-digit code it shows.</p>

                <img src="/settings/security/totp-qr.png" width="256" height="256"
                     alt="QR code for two-factor authentication setup">

                <p class="note">If you cannot scan it, enter this key in the app: <code>{{ .Secret }}</code></p>

                <form method="post" action="/settings/security/totp/confirm" class="stack">
                    <label class="stack">
                        <span class="eyebrow">Code</span>
                        <input class="input" type="text" name="code" inputmode="numeric" autocomplete="one-time-code"
                               minlength="6" maxlength="6" autofocus required>
                    </label>
                    <button type="submit" class="btn">Turn on</button>
                </form>
            {{- else if .TOTPEnabled }}
                <p class="notice notice--ok" role="status">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5"/>
                    </svg>
                    <span>Two-factor authentication is on.</span>
                </p>

                <p class="note">{{ .RecoveryCodesRemaining }} recovery code{{ if ne .RecoveryCodesRemaining 1 }}s{{ end }} remaining.</p>

                <div class="security__actions">
                    <button type="button" class="btn btn--quiet btn--sm" data-open="regenerate-dialog">
                        Regenerate recovery codes
                    </button>
                    <button type="button" class="btn btn--quiet btn--sm btn--danger" data-open="disable-dialog">
                        Turn off two-factor authentication
                    </button>
                </div>

                <dialog class="modal" id="regenerate-dialog" aria-labelledby="regenerate-dialog-title">
                    <div class="modal__head">
                        <div>
                            <h2 class="modal__title" id="regenerate-dialog-title">Regenerate recovery codes</h2>
                            <p class="modal__sub">Your current codes stop working immediately.</p>
                        </div>
                        <button type="button" class="modal__close" data-close aria-label="Close">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M6 6l12 12M18 6 6 18"/>
                            </svg>
                        </button>
                    </div>

                    <form method="post" action="/settings/security/recovery-codes/regenerate">
                        <div class="modal__body">
                            <label class="stack">
                                <span class="eyebrow">Password</span>
                                <input class="input" type="password" name="password" autocomplete="current-password"
                                       minlength="8" maxlength="1000" autofocus required>
                            </label>
                        </div>
                        <div class="modal__foot">
                            <button type="button" class="btn btn--quiet btn--sm" data-close>Cancel</button>
                            <button type="submit" class="btn btn--sm">Regenerate</button>
                        </div>
                    </form>
                </dialog>

                <dialog class="modal" id="disable-dialog" aria-labelledby="disable-dialog-title">
                    <div class="modal__head">
                        <div>
                            <h2 class="modal__title" id="disable-dialog-title">Turn off two-factor authentication</h2>
                            <p class="modal__sub">Signing in will ask for your password only.</p>
                        </div>
                        <button type="button" class="modal__close" data-close aria-label="Close">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M6 6l12 12M18 6 6 18"/>
                            </svg>
                        </button>
                    </div>

                    <form method="post" action="/settings/security/totp/disable">
                        <div class="modal__body">
                            <label class="stack">
                                <span class="eyebrow">Password</span>
                                <input class="input" type="password" name="password" autocomplete="current-password"
                                       minlength="8" maxlength="1000" autofocus required>
                            </label>
                        </div>
                        <div class="modal__foot">
                            <button type="button" class="btn btn--quiet btn--sm" data-close>Cancel</button>
                            <button type="submit" class="btn btn--quiet btn--sm btn--danger">Turn off</button>
                        </div>
                    </form>
                </dialog>
            {{- else }}
                <p>Two-factor authentication is off. To turn it on, you need an
                    authenticator app, such as Google Authenticator or 1Password.</p>

                <form method="post" action="/settings/security/totp/enroll">
                    <button type="submit" class="btn">Turn on two-factor authentication</button>
                </form>
            {{- end }}
        </div>
    </section>

    {{- template "layout/foot" . }}
{{ end }}
