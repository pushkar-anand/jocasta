{{ define "page/traffic" }}
{{- template "layout/head" . }}

{{- if not .Recorded }}
<section class="block">
    <h2 class="section">Traffic</h2>
    <div class="card empty">
        <p>No traffic recorded yet. Once your router sends its flow records to
            Jocasta, this page shows the busiest devices, where they connect on
            the internet, and who they have started talking to.</p>
        <p>To set it up, see <a href="https://github.com/pushkar-anand/jocasta/blob/main/docs/setup.md#record-who-devices-talk-to">Record who devices talk to</a>.</p>
    </div>
</section>
{{- else }}

<div id="traffic-cards">
<section class="block" aria-label="Which traffic">

    {{- /* The form and the tabs swap everything under the heading and push their
           own address, so the page can be reloaded or shared as it is shown.
           Without htmx the form submits and the tabs are plain links. */}}
    <form class="filters" role="search" action="/traffic" method="get"
          hx-get="/traffic"
          hx-select="#traffic-cards"
          hx-target="#traffic-cards"
          hx-swap="outerHTML"
          hx-push-url="true"
          hx-sync="this:replace"
          hx-trigger="change, submit">
        {{- with .Tab.Key }}<input type="hidden" name="tab" value="{{ . }}">{{ end }}

        <label class="field">
            <span class="visually-hidden">Period</span>
            <select id="traffic-page-window" name="window">
                {{- range .Windows }}
                <option value="{{ .Key }}"{{ if eq .Key $.Window.Key }} selected{{ end }}>Last {{ .Label }}</option>
                {{- end }}
            </select>
        </label>

        {{- if .Groups }}
        <label class="field">
            <span class="visually-hidden">Group</span>
            <select id="traffic-page-group" name="group">
                <option value="">Any group</option>
                {{- range .Groups }}
                <option value="{{ . }}"{{ if eq . $.Group }} selected{{ end }}>{{ . }}</option>
                {{- end }}
            </select>
        </label>
        {{- end }}

        <noscript><button type="submit" class="btn">Apply</button></noscript>
    </form>

    {{- if gt (len .Tabs) 1 }}
    <nav class="tabs" aria-label="Which devices">
        {{- range .Tabs }}
        <a class="tabs__tab{{ if not .Devices }} tabs__tab--empty{{ end }}"
           href="{{ $.TabPath .Key }}"
           hx-get="{{ $.TabPath .Key }}"
           hx-select="#traffic-cards"
           hx-target="#traffic-cards"
           hx-swap="outerHTML"
           hx-push-url="true"
           {{- if eq .Key $.Tab.Key }} aria-current="page"{{ end }}>
            {{- .Label }}{{ with .VLAN }} <span class="tabs__vlan">VLAN {{ . }}</span>{{ end }}
            <span class="tabs__count">{{ .Devices }}</span></a>
        {{- end }}
    </nav>
    {{- end }}

    {{- with .Summary }}
    <div class="card traffic__summary">
        <dl class="stats">
            <div><dd>{{ bytes .Received }}</dd><dt>Received</dt></div>
            <div><dd>{{ bytes .Sent }}</dd><dt>Sent</dt></div>
            <div><dd>{{ .Devices }}</dd><dt>{{ if eq .Devices 1 }}Device{{ else }}Devices{{ end }} active</dt></div>
            <div{{ if not .Probing }} class="stat--quiet"{{ end }}><dd>{{ .Probing }}</dd><dt>Probing</dt></div>
        </dl>
    </div>
    {{- end }}
</section>

<section class="block">
    <h2 class="section">Probing your network</h2>
    <p class="note">Devices that, within an hour, tried many addresses or many
        ports on one address without exchanging any data. A device you run scans
        from shows up here too.</p>
    {{- if .Probers }}
    <div class="card card--table">
        <div class="scroller">
            <table>
                <thead>
                <tr>
                    <th scope="col">Device</th>
                    <th scope="col">What it did</th>
                    <th scope="col" class="num">Answered</th>
                    <th scope="col">Last seen</th>
                </tr>
                </thead>
                <tbody>
                {{- range .Probers }}
                <tr>
                    <td><a href="/devices/{{ .DeviceID }}#traffic">{{ .DeviceName }}</a></td>
                    <td>
                        {{- if .SweptAddresses }}Tried {{ .Peers }} addresses{{ if .SweptPorts }}, up to {{ .MaxPorts }} ports on one{{ end }}
                        {{- else }}Tried {{ .MaxPorts }} ports on one address{{ end }}
                        {{- if gt .Hours 1 }} <span class="dim">in {{ .Hours }} hours</span>{{ end }}
                        {{- with .Ports }}<br><span class="dim">ports {{ portList . }}</span>{{ end }}
                    </td>
                    <td class="num">{{ count .Answered }} of {{ count .Attempts }}</td>
                    <td class="dim">{{ stamp .LastHour "" }}</td>
                </tr>
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
    {{- else }}
    <p class="dim">No device{{ if .Tab.Key }} on {{ .Tab.Label }}{{ end }} probed your network in the last {{ .Window.Label }}{{ with .Group }} among devices in {{ . }}{{ end }}.</p>
    {{- end }}
</section>

<section class="block">
    <h2 class="section">Reached from the internet</h2>
    {{- with .BehindNAT }}
    <div class="notice" role="note">
        <p><strong>Your router is behind another NAT.</strong>
            Its outside address, <span class="mono">{{ .Addr }}</span>, is
            {{ if .CGNAT }}one your ISP shares between customers (carrier-grade NAT){{ else }}a private address, so something sits between it and the internet: usually your ISP's NAT, sometimes another router{{ end }}.
            Nothing on the internet can connect in over IPv4 unless that NAT
            forwards it, so this card and the next stay empty. IPv6 is not
            affected.</p>
    </div>
    {{- end }}
    <p class="note">Services on your devices that someone on the internet
        connected to. A forwarded port missing from this list was not reached in
        this period.</p>
    {{- if .Incoming }}
    <div class="card card--table">
        <div class="scroller">
            <table>
                <thead>
                <tr>
                    <th scope="col">Device</th>
                    <th scope="col">Service</th>
                    <th scope="col">From</th>
                    <th scope="col" class="num">Connections</th>
                    <th scope="col" class="num">Sent</th>
                    <th scope="col">Last seen</th>
                </tr>
                </thead>
                <tbody>
                {{- range .Incoming }}
                <tr>
                    <td><a href="/devices/{{ .DeviceID }}?tab=internet#traffic">{{ .DeviceName }}</a></td>
                    <td>{{ with .Service }}{{ . }} {{ end }}<span class="dim">{{ with proto .Protocol }}{{ . }} {{ end }}{{ .Port }}</span></td>
                    <td>{{ count .Peers }} {{ if eq .Peers 1 }}address{{ else }}addresses{{ end }}
                        <span class="dim">&middot; {{ .Orgs }} {{ if eq .Orgs 1 }}organisation{{ else }}organisations{{ end }}</span></td>
                    <td class="num">{{ count .Connections }}</td>
                    <td class="num">{{ bytes .Sent }}</td>
                    <td class="dim">{{ stamp .LastHour "" }}</td>
                </tr>
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
    {{- else }}
    <p class="dim">Nothing on the internet opened a connection to a device{{ if .Tab.Key }} on {{ .Tab.Label }}{{ end }} in the last {{ .Window.Label }}.</p>
    {{- end }}
</section>

<section class="block">
    <h2 class="section">Probed from the internet</h2>
    <p class="note">Connections from the internet that carried no data: knocks on
        a forwarded port, or on your router's outside address, which is counted
        under the router. Most of this is routine internet scanning. Check the
        answered ones.</p>
    {{- if .Probed }}
    <div class="card card--table">
        <div class="scroller">
            <table>
                <thead>
                <tr>
                    <th scope="col">Tried</th>
                    <th scope="col">By</th>
                    <th scope="col" class="num">Answered</th>
                    <th scope="col">Last seen</th>
                </tr>
                </thead>
                <tbody>
                {{- range .Probed }}
                <tr>
                    <td>
                        {{- if .Outside }}Outside address <span class="dim">of</span> {{ end -}}
                        <a href="/devices/{{ .DeviceID }}#traffic">{{ .DeviceName }}</a></td>
                    <td>{{ count .Peers }} {{ if eq .Peers 1 }}address{{ else }}addresses{{ end }}
                        <span class="dim">&middot; {{ .Orgs }} {{ if eq .Orgs 1 }}organisation{{ else }}organisations{{ end }}</span>
                        {{- with .Ports }}<br><span class="dim">ports {{ portList . }}</span>{{ end }}</td>
                    <td class="num">{{ count .Answered }} of {{ count .Attempts }}</td>
                    <td class="dim">{{ stamp .LastHour "" }}</td>
                </tr>
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
    {{- else }}
    <p class="dim">Nothing on the internet tried a device{{ if .Tab.Key }} on {{ .Tab.Label }}{{ end }} in the last {{ .Window.Label }}.</p>
    {{- end }}
</section>

<div class="traffic-cols">
<section class="block">
    <h2 class="section">Busiest devices</h2>
    {{- if .Busiest }}
    <div class="card card--table">
        <div class="scroller">
            <table>
                <thead>
                <tr>
                    <th scope="col">Device</th>
                    <th scope="col" class="num">Sent</th>
                    <th scope="col" class="num">Received</th>
                </tr>
                </thead>
                <tbody>
                {{- range .Busiest }}
                <tr>
                    <td><a href="/devices/{{ .DeviceID }}#traffic">{{ .DeviceName }}</a></td>
                    <td class="num">{{ bytes .Sent }}</td>
                    <td class="num">{{ bytes .Received }}</td>
                </tr>
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
    {{- else }}
    <p class="dim">No traffic recorded in the last {{ .Window.Label }}{{ if .Tab.Key }} for devices on {{ .Tab.Label }}{{ end }}{{ with .Group }} in {{ . }}{{ end }}.</p>
    {{- end }}
</section>

<section class="block">
    <h2 class="section">Top internet destinations</h2>
    {{- if .TopOrgs }}
    <div class="card card--table">
        <div class="scroller">
            <table>
                <thead>
                <tr>
                    <th scope="col">Organisation</th>
                    <th scope="col" class="num">Sent</th>
                    <th scope="col" class="num">Received</th>
                </tr>
                </thead>
                <tbody>
                {{- range .TopOrgs }}
                <tr>
                    <td>
                        <details class="peers">
                            <summary>
                                <span class="strong" title="{{ .Name }}">{{ .Short }}</span>
                                <span class="dim">{{ .Devices }} {{ if eq .Devices 1 }}device{{ else }}devices{{ end }}</span>
                            </summary>
                            <ul class="peers__list">
                                {{- range .DeviceList }}
                                <li><a href="/devices/{{ .DeviceID }}#traffic">{{ .DeviceName }}</a>
                                    <span class="peers__detail">{{ bytes .Sent }} sent &middot; {{ bytes .Received }} received</span></li>
                                {{- end }}
                            </ul>
                        </details>
                    </td>
                    <td class="num">{{ bytes .Sent }}</td>
                    <td class="num">{{ bytes .Received }}</td>
                </tr>
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
    {{- else }}
    <p class="dim">No internet traffic recorded in the last {{ .Window.Label }}.</p>
    {{- end }}
    <p class="note">Hourly totals from your router. {{ .Attribution }}.</p>
</section>
</div>

<section class="block">
    <h2 class="section">New this week</h2>
    <p class="note">Organisations a device first exchanged data with in the last
        7 days{{ if .First.Partial }}, the most data first{{ end }}.{{ if .First.Partial }} Traffic has only been recorded
        since {{ stamp .First.Started "" }}, so for the first week
        everything counts as new.{{ end }}</p>
    {{- if .NewOrgs }}
    <div class="card card--table">
        <div class="scroller">
            <table>
                <thead>
                <tr>
                    <th scope="col">Organisation</th>
                    <th scope="col">First seen</th>
                    <th scope="col" class="num">Exchanged</th>
                </tr>
                </thead>
                <tbody>
                {{- range .NewOrgs }}
                <tr>
                    <td>
                        <details class="peers">
                            <summary>
                                <span class="strong" title="{{ .Name }}">{{ .Short }}</span>
                                <span class="dim">{{ len .Devices }} {{ if eq (len .Devices) 1 }}device{{ else }}devices{{ end }}</span>
                            </summary>
                            <ul class="peers__list">
                                {{- range .Devices }}
                                <li><a href="/devices/{{ .DeviceID }}#traffic">{{ .DeviceName }}</a>
                                    <span class="peers__detail">{{ stamp .First "" }} &middot; {{ bytes .Bytes }}</span></li>
                                {{- end }}
                            </ul>
                        </details>
                    </td>
                    <td class="dim">{{ stamp .First "" }}</td>
                    <td class="num">{{ bytes .Bytes }}</td>
                </tr>
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
    {{- with .MoreNewOrgs }}
    <p class="note">And {{ . }} more {{ if eq . 1 }}organisation{{ else }}organisations{{ end }}{{ if $.First.Partial }}, all new because recording started recently{{ end }}.</p>
    {{- end }}
    {{- else }}
    <p class="dim">No device reached a new organisation this week.</p>
    {{- end }}
</section>

</div>
{{- end }}

{{- template "layout/foot" . }}
{{ end }}
