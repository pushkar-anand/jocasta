{{ define "page/traffic" }}
{{- template "layout/head" . }}

{{- if not .Recorded }}
<section class="block">
    <h2 class="section">Traffic</h2>
    <div class="card empty">
        <p>No traffic recorded yet. Once your router sends its traffic records
            to Jocasta, this page shows which devices are busiest, where on the
            internet they connect, and who they started talking to lately.</p>
        <p>See &ldquo;Seeing who devices talk to&rdquo; in the setup guide.</p>
    </div>
</section>
{{- else }}

<section class="block">
    <div class="block__head">
        <h2 class="section">Traffic</h2>
        <p class="block__aside">Hourly totals from your router</p>
    </div>

    <nav class="logfilter" aria-label="Traffic period">
        {{- range .Windows }}
        <a href="/traffic{{ if ne .Key "24h" }}?window={{ .Key }}{{ end }}"
           {{- if eq .Key $.Window.Key }} aria-current="page"{{ end }}>Last {{ .Label }}</a>
        {{- end }}
    </nav>
</section>

<section class="block">
    <h2 class="section">Busiest devices</h2>
    {{- if .Busiest }}
    <div class="card card--table">
        <div class="scroller">
            <table>
                <thead>
                <tr>
                    <th scope="col">Device</th>
                    <th scope="col" class="num">Sent</th>
                    <th scope="col" class="num">Received</th>
                </tr>
                </thead>
                <tbody>
                {{- range .Busiest }}
                <tr>
                    <td><a href="/devices/{{ .DeviceID }}#traffic">{{ .DeviceName }}</a></td>
                    <td class="num">{{ bytes .Sent }}</td>
                    <td class="num">{{ bytes .Received }}</td>
                </tr>
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
    {{- else }}
    <p class="dim">No traffic recorded in the last {{ .Window.Label }}.</p>
    {{- end }}
</section>

<section class="block">
    <h2 class="section">New this week</h2>
    <p class="note">Organisations a device exchanged data with for the first time
        in the last 7 days.{{ if .First.Partial }} Traffic has only been recorded
        since {{ stamp .First.Started "" }}, so until a week has passed everything
        counts as new.{{ end }}</p>
    {{- if .First.Contacts }}
    <div class="card card--table">
        <div class="scroller">
            <table>
                <thead>
                <tr>
                    <th scope="col">Device</th>
                    <th scope="col">First talked to</th>
                    <th scope="col">When</th>
                    <th scope="col" class="num">Exchanged</th>
                </tr>
                </thead>
                <tbody>
                {{- range .First.Contacts }}
                <tr>
                    <td><a href="/devices/{{ .DeviceID }}#traffic">{{ .DeviceName }}</a></td>
                    <td><span class="strong" title="{{ .Name }}">{{ .Short }}</span></td>
                    <td class="dim">{{ stamp .First "" }}</td>
                    <td class="num">{{ bytes .Bytes }}</td>
                </tr>
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
    {{- else }}
    <p class="dim">No device reached a new organisation this week.</p>
    {{- end }}
</section>

<section class="block">
    <h2 class="section">Top internet destinations</h2>
    {{- if .TopOrgs }}
    <div class="card card--table">
        <div class="scroller">
            <table>
                <thead>
                <tr>
                    <th scope="col">Organisation</th>
                    <th scope="col" class="num">Devices</th>
                    <th scope="col" class="num">Sent</th>
                    <th scope="col" class="num">Received</th>
                </tr>
                </thead>
                <tbody>
                {{- range .TopOrgs }}
                <tr>
                    <td><span class="strong" title="{{ .Name }}">{{ .Short }}</span></td>
                    <td class="num">{{ .Devices }}</td>
                    <td class="num">{{ bytes .Sent }}</td>
                    <td class="num">{{ bytes .Received }}</td>
                </tr>
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
    {{- else }}
    <p class="dim">No internet traffic recorded in the last {{ .Window.Label }}.</p>
    {{- end }}
    <p class="note">{{ .Attribution }}.</p>
</section>
{{- end }}

{{- template "layout/foot" . }}
{{ end }}
