{{ define "page/map" }}
{{- template "layout/head" . }}

{{- if not .Recorded }}
<section class="block">
    <h2 class="section">Map</h2>
    <div class="card empty">
        <p>No traffic recorded yet. Once your router sends its flow records to
            Jocasta, this map shows which devices talk to each other and to the
            internet.</p>
        <p>To set it up, see <a href="https://github.com/pushkar-anand/jocasta/blob/main/docs/setup.md#record-who-devices-talk-to">Record who devices talk to</a>.</p>
    </div>
</section>
{{- else }}
<section class="block">
    <div class="block__head">
        <nav class="tabs" aria-label="Which map">
            <a class="tabs__tab" href="/map"{{ if not .World }} aria-current="page"{{ end }}>Network</a>
            <a class="tabs__tab" href="/map?view=world"{{ if .World }} aria-current="page"{{ end }}>World</a>
        </nav>
        <p class="block__aside">Last hour</p>
    </div>

    {{- /* The search sits outside what the poll swaps, so what was typed
           outlives each redraw; netmap.js applies it to the new map. The
           wrapper polls and outlives every tick; the poll swaps only what is
           inside it, which is what /map/live answers with. */}}
    <div class="netmap-wrap">
        <label class="netmap__search">
            <span class="visually-hidden">Find {{ if .World }}a country{{ else }}a device or organisation{{ end }}</span>
            <input id="netmap-search" type="search" placeholder="Search" autocomplete="off" spellcheck="false">
        </label>
        {{- if .World }}
        {{- template "partial/map-world" . }}
        {{- else }}
        <div id="map-live" hx-get="/map/live" hx-trigger="every 60s" hx-swap="innerHTML">
            {{- template "partial/map-body" . }}
        </div>
        {{- end }}
    </div>
</section>
{{- end }}

{{- template "layout/foot" . }}
{{ end }}
