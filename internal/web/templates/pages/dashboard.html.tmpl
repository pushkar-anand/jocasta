{{ define "page/dashboard" }}
{{- template "layout/head" . }}

{{ if .Stats.Total }}
{{- template "partial/live" . }}
{{ else }}
<section class="block">
    <p class="eyebrow">Inventory</p>
    <div class="card empty">
        <p>No devices yet. Jocasta records what a sweep finds; it does not probe
            the network on its own.</p>
        <p>Sweep a prefix and keep the results:</p>
        <p><code>jocasta scan 192.168.1.0/24 --save</code></p>
    </div>
</section>
{{ end }}

{{- template "layout/foot" . }}
{{ end }}
