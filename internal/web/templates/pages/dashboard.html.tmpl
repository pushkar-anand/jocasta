{{ define "page/dashboard" }}
{{- template "layout/head" . }}

{{ if .Stats.Total }}
{{- template "partial/live" . }}
{{ else }}
<section class="block">
    <h2 class="section">Inventory</h2>
    <div class="card empty">
        <p>No devices yet.</p>
        <p>List your networks under <code>networks</code> in the config and
            <code>jocasta serve</code> sweeps them on a schedule. To sweep one now:</p>
        <p><code>jocasta scan 192.0.2.0/24 --save</code></p>
    </div>
</section>
{{ end }}

{{- template "layout/foot" . }}
{{ end }}
