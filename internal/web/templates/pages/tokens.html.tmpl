{{ define "page/tokens" }}
    {{- template "layout/head" . }}

    <section class="block">
        <div class="block__head">
            <p class="eyebrow">API tokens</p>
            <p class="block__aside">Bearer credentials for a script or dashboard that reads or edits this inventory
                without signing in.</p>
        </div>

        <div class="card panel">
            <form method="post" action="/settings/tokens" class="tokenform">
                <label class="stack">
                    <span class="eyebrow">Name</span>
                    <input class="input" type="text" name="name" placeholder="e.g. Grafana dashboard"
                           autocomplete="off" maxlength="100" required>
                </label>

                <fieldset class="tokenform__scope">
                    <label class="check">
                        <input type="radio" name="scope" value="read" checked>
                        Read
                    </label>
                    <label class="check">
                        <input type="radio" name="scope" value="read_write">
                        Read &amp; write
                    </label>
                </fieldset>

                <button type="submit" class="btn btn--sm">Create token</button>
            </form>
        </div>

        {{- /*
            Reveal and list share one wrapper so a revoke -- which swaps this
            whole region -- also clears a plaintext left over from a create
            just before it, and lands on the "none yet" line when it takes the
            last row rather than on an empty table.
        */ -}}
        {{ template "partial/token-list" . }}
    </section>

    {{- template "layout/foot" . }}
{{ end }}
