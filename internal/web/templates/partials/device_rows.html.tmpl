{{- /*
    Only the table. The filter form swaps this, and the page renders it inline
    on first paint.
*/ -}}
{{ define "partial/device-rows" }}
<div id="device-rows">
    {{- /* Inside the swapped fragment. So a filtered count is current at the
           same time as the table. */}}
    <p class="rowcount">{{ .Count }}{{ if .Filtered }} <a class="clear" href="{{ .FilterAction }}">clear</a>{{ end }}</p>

    {{- if .Devices }}
    <div class="card card--table">
        <div class="scroller">
            {{- /* On the page of a network, the Network column would repeat the
                   page on every row. The row partial does not know its context.
                   This container knows, so it hides column 3. */}}
            <table{{ if .OnNetwork }} class="on-network"{{ end }}>
                <thead>
                <tr>
                    <th scope="col">Device</th>
                    <th scope="col">Addresses</th>
                    <th scope="col">Network</th>
                    <th scope="col">Hardware</th>
                    <th scope="col">Group</th>
                    <th scope="col">Last seen</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
                </thead>
                <tbody>
                {{- range .Rows }}
                {{- template "partial/device-row" . }}
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
    {{- with .Pager }}
    {{- /*
        Plain links. A page change moves the address bar as much as the table.
        So a full navigation is the correct choice. The event and scan logs make
        the same choice.
    */}}
    <nav class="pager pager--split" aria-label="Device list pages">
        {{- if .HasPrev }}
        <a class="more" href="{{ .PrevHref }}" rel="prev">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
            Previous
        </a>
        {{- end }}
        <span class="block__aside">Page {{ .Page }} of {{ .Pages }}</span>
        {{- if .HasNext }}
        <a class="more" href="{{ .NextHref }}" rel="next">Next
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </a>
        {{- end }}
    </nav>
    {{- end }}
    {{- else if .Filtered }}
    <div class="card empty">
        <p>No device matches this filter.</p>
    </div>
    {{- else }}
    <div class="card empty">
        <p>No devices yet. They appear here after the first sweep of your networks. To sweep one now:</p>
        <p><code>jocasta scan 192.0.2.0/24 --save</code></p>
    </div>
    {{- end }}

    {{- /* Every group field of a row shares this. So it is written once. */}}
    <datalist id="known-groups">
        {{- range .Groups }}
        <option value="{{ . }}"></option>
        {{- end }}
    </datalist>
</div>
{{ end }}
