{{- /*
    The table on its own. This is what the filter form swaps, and what the page
    renders inline on first paint.
*/ -}}
{{ define "partial/device-rows" }}
<div id="device-rows">
    {{- /* Inside the swapped fragment, so a filtered-down count is current the
           moment the table is. */}}
    <p class="rowcount">{{ .Count }}{{ if .Filtered }} <a class="clear" href="{{ .FilterAction }}">clear</a>{{ end }}</p>

    {{- if .Devices }}
    <div class="card card--table">
        <div class="scroller">
            <table>
                <thead>
                <tr>
                    <th scope="col">Device</th>
                    <th scope="col">Addresses</th>
                    <th scope="col">Network</th>
                    <th scope="col">Ports</th>
                    <th scope="col">Hardware</th>
                    <th scope="col">Vendor</th>
                    <th scope="col">Group</th>
                    <th scope="col">Last seen</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
                </thead>
                <tbody>
                {{- range .Devices }}
                {{- template "partial/device-row" . }}
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
    {{- with .Pager }}
    {{- /*
        Plain links, not an htmx swap: a page change moves the address bar as
        much as it moves the table, so a full navigation is the honest thing --
        the same choice the event and scan logs make.
    */}}
    <nav class="pager pager--split" aria-label="Device list pages">
        {{- if .HasPrev }}
        <a class="more" href="{{ .PrevHref }}" rel="prev">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
            Previous
        </a>
        {{- end }}
        <span class="block__aside">Page {{ .Page }} of {{ .Pages }}</span>
        {{- if .HasNext }}
        <a class="more" href="{{ .NextHref }}" rel="next">Next
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </a>
        {{- end }}
    </nav>
    {{- end }}
    {{- else if .Filtered }}
    <p class="dim">No device matches this filter.</p>
    {{- else }}
    <p class="dim">No devices yet. Jocasta builds this list from the sweeps it runs on the networks you configure.</p>
    {{- end }}

    {{- /* Shared by every row's group field, so it is written once. */}}
    <datalist id="known-groups">
        {{- range .Groups }}
        <option value="{{ . }}"></option>
        {{- end }}
    </datalist>
</div>
{{ end }}
