{{- /*
    The filter form of the device list. The Devices page and the page of a
    network share it. FilterAction is where it sends, and FilterRows is what it
    fetches. So the same form filters /devices, or the list on one prefix. On
    the page of a network, OnNetwork is set, and the network select is left out.
    The path already names the network.

    The form fetches only the table, when search.js tells it to. See search.js
    for when a search goes out. It targets the fragment endpoint. That endpoint
    answers with HX-Push-Url, which names the page. So a person can reload or
    share the address in the address bar. Without htmx, the form sends in the
    normal way, and the server renders the filtered page.
*/ -}}
{{ define "partial/device-filters" }}
<form id="device-filters" class="filters" role="search" action="{{ .FilterAction }}" method="get"
      hx-get="{{ .FilterRows }}"
      hx-target="#device-rows"
      hx-swap="outerHTML"
      hx-sync="this:replace"
      hx-request='{"timeout":15000}'
      hx-trigger="filter, submit" data-live>
    <label class="field field--search">
        <span class="visually-hidden">Find</span>
        <svg class="field__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
        </svg>
        <input type="search" name="q" value="{{ .Query }}"
               placeholder="Search name, address or vendor" autocomplete="off">
    </label>

    <label class="field">
        <span class="visually-hidden">Group</span>
        <select name="group">
            <option value="">Any group</option>
            {{- range .Groups }}
            <option value="{{ . }}"{{ if eq . $.Group }} selected{{ end }}>{{ . }}</option>
            {{- end }}
        </select>
    </label>

    {{- if not .OnNetwork }}
    <label class="field">
        <span class="visually-hidden">Network</span>
        <select name="network">
            <option value="">Any network</option>
            {{- range .Networks }}
            <option value="{{ .ID }}"{{ if eq (printf "%d" .ID) $.Network }} selected{{ end }}>
                {{- .CIDR }}{{ with .Name }} &middot; {{ . }}{{ end }}{{ if .VLAN }} &middot; VLAN {{ .VLAN }}{{ end -}}
            </option>
            {{- end }}
        </select>
    </label>
    {{- end }}

    <label class="field">
        <span class="visually-hidden">Type</span>
        <select name="type">
            <option value="">Any type</option>
            {{- range classChoices }}
            <option value="{{ .Value }}"{{ if eq (printf "%s" .Value) $.Type }} selected{{ end }}>{{ .Label }}</option>
            {{- end }}
        </select>
    </label>

    <label class="field">
        <span class="visually-hidden">Seen</span>
        <select name="status">
            <option value="">Any presence</option>
            <option value="online"{{ if eq .Status "online" }} selected{{ end }}>Seen recently</option>
            <option value="offline"{{ if eq .Status "offline" }} selected{{ end }}>Quiet</option>
        </select>
    </label>

    <label class="field">
        <span class="visually-hidden">Order</span>
        <select name="sort">
            <option value="">Last seen</option>
            <option value="address"{{ if eq .Sort "address" }} selected{{ end }}>Address</option>
            <option value="name"{{ if eq .Sort "name" }} selected{{ end }}>Name</option>
            <option value="type"{{ if eq .Sort "type" }} selected{{ end }}>Type</option>
        </select>
    </label>

    <label class="check">
        <input type="checkbox" name="watched" value="1"{{ if .Watched }} checked{{ end }}>
        <span>Watched only</span>
    </label>

    <label class="check">
        <input type="checkbox" name="ignored" value="1"{{ if .IncludeIgnored }} checked{{ end }}>
        <span>Show ignored</span>
    </label>

    {{- /* Used only without htmx, where the form must be sent. The clear link
           is with the result count, inside the fragment that htmx swaps. So it
           never shows when no filter is set. */}}
    <noscript><button type="submit" class="btn">Apply</button></noscript>
</form>
<div>
    <p id="device-filter-status" role="status" aria-live="polite" aria-atomic="true"></p>
    <button id="device-filter-retry" type="submit" form="device-filters" class="btn btn--sm" hidden>Retry</button>
</div>
{{ end }}
