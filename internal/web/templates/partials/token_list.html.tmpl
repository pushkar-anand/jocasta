{{- /*
    The token completion state and the list, in one wrapper the revoke button
    swaps whole (hx-target="#token-list"). Rendered inline by page/tokens on
    first paint, returned on its own by revokeToken. Swapping the whole wrapper
    means the last revoke lands on the "none yet" line and drops a plaintext
    still shown from a create just before it.

    Takes tokensData: PlaintextToken / NewName / NewScope are set only on the GET
    a create redirects to; Revoked is set only on the revoke response; Tokens is
    the caller's list, newest first.
*/ -}}
{{ define "partial/token-list" }}
<div id="token-list" tabindex="-1">
    {{- with .PlaintextToken }}
        <div class="tokenreveal">
            <p class="tokenreveal__label">
                {{ $.NewName }} created{{ with $.NewScope }} ({{ scopedisplay . }}){{ end }}
            </p>
            <p class="tokenreveal__hint">Copy it now. It will not be shown again. If you lose it, revoke it
                and create a new one.</p>

            <div class="tokenreveal__row">
                <code class="tokenreveal__value" id="token-plaintext">{{ . }}</code>
                <button type="button" class="btn btn--quiet btn--sm" data-copy="#token-plaintext">Copy</button>
            </div>

            <details class="tokenreveal__use">
                <summary>Use it as a bearer token</summary>
                <div class="tokenreveal__row">
                    <code class="tokenreveal__curl" id="token-curl">curl -H 'Authorization: Bearer {{ . }}' "$JOCASTA_URL/api/devices"</code>
                    <button type="button" class="btn btn--quiet btn--sm" data-copy="#token-curl">Copy</button>
                </div>
            </details>
        </div>
    {{- end }}

    {{- if .Revoked }}
        <p class="notice" role="status">Token revoked.</p>
    {{- end }}

    {{- if .Tokens }}
        <div class="card card--table">
            <div class="scroller">
                <table>
                    <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Permission</th>
                        <th scope="col">Created</th>
                        <th scope="col">Last used</th>
                        <th scope="col"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {{- range .Tokens }}
                        <tr id="token-row-{{ .ID }}">
                            <td class="cell strong">{{ .Name }}</td>
                            <td>
                                {{- if eq .Scope "read_write" }}
                                    <span class="chip chip--brand">Editor</span>
                                {{- else }}
                                    <span class="chip chip--quiet chip--label">Viewer</span>
                                {{- end }}
                            </td>
                            <td class="dim">{{ stamp .CreatedAt "" }}</td>
                            <td class="dim">{{ stamp .LastUsedAt "" }}</td>
                            <td>
                                <button type="button" class="btn btn--quiet btn--sm btn--danger"
                                        data-open="revoke-dialog-{{ .ID }}">
                                    Revoke
                                </button>
                            </td>
                        </tr>
                    {{- end }}
                    </tbody>
                </table>
            </div>
        </div>

        {{- range .Tokens }}
        <dialog class="modal" id="revoke-dialog-{{ .ID }}" aria-labelledby="revoke-dialog-{{ .ID }}-title">
            <div class="modal__head">
                <div>
                    <h2 class="modal__title" id="revoke-dialog-{{ .ID }}-title">Revoke &ldquo;{{ .Name }}&rdquo;</h2>
                    <p class="modal__sub">Anything using this token stops working immediately.</p>
                </div>
                <button type="button" class="modal__close" data-close aria-label="Close">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6 6 18"/>
                    </svg>
                </button>
            </div>
            <div class="modal__foot">
                <button type="button" class="btn btn--quiet btn--sm" data-close>Cancel</button>
                <button type="button" class="btn btn--quiet btn--sm btn--danger"
                        hx-delete="/settings/tokens/{{ .ID }}"
                        hx-target="#token-list"
                        hx-swap="outerHTML">Revoke token</button>
            </div>
        </dialog>
        {{- end }}
    {{- else }}
        <p class="dim">No tokens yet. Create one to use the API or the MCP server.</p>
    {{- end }}
</div>
{{ end }}
