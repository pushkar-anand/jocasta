{{- /*
    The device's identity and the form that curates it, side by side, so saving
    a label updates the facts that show it rather than only the field.
*/ -}}
{{ define "partial/device-panel" }}
<div id="device-panel">
    <div class="glance">
        {{- with .Device }}
        <section class="card panel">
            <div class="block__head">
                <p class="eyebrow">Identity</p>
                <span class="chip">{{ .IdentitySource }}</span>
            </div>

            <dl class="facts">
                <div><dt>Hardware</dt><dd class="mono">{{ dash .MAC }}</dd></div>
                <div><dt>Vendor</dt><dd>{{ dash .Vendor }}</dd></div>
                <div><dt>Hostname</dt><dd>{{ dash .Hostname }}</dd></div>
                <div><dt>Type</dt><dd>
                    {{- with .Class }}
                    <span class="cell">
                        {{- with classIcon . }}
                        <svg class="devicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ . }}</svg>
                        {{- end }}
                        {{ classLabel . }}
                        {{- if not $.Device.Type }}
                        <span class="chip chip--quiet">auto</span>
                        {{- with confidence $.Device.ClassConfidence }}<span class="chip chip--quiet">{{ . }}</span>{{ end }}
                        {{- end }}
                    </span>
                    {{- else }}<span class="dim">{{ dash "" }}</span>{{ end }}
                </dd></div>
                <div><dt>Group</dt><dd>{{ dash .Group }}</dd></div>
                <div><dt>First seen</dt><dd class="dim">{{ ago .FirstSeen }}</dd></div>
                <div><dt>Last seen</dt><dd class="dim">{{ ago .LastSeen }}</dd></div>
                <div><dt>Last checked</dt><dd class="dim">{{ ago $.LastChecked }}</dd></div>
            </dl>

            {{- if .Randomised }}
            <p class="note">This hardware address is locally administered: the device
                generated it for itself, so it names no vendor and will not survive the
                next time the device associates.</p>
            {{- end }}

            {{- /* The type is yours, and the classifier would have said something
                   else. Worth showing: its guess is why "auto" would land elsewhere
                   if you cleared the override. */}}
            {{- if and .Type .ClassGuess (ne .ClassGuess .Class) }}
            <p class="note">Left to itself the classifier reads this as
                {{ classLabel .ClassGuess }}{{ with confidence .ClassConfidence }}, with {{ . }}{{ end }}.</p>
            {{- end }}
        </section>
        {{- end }}

        <section class="card panel">
            <p class="eyebrow">What you call it</p>

            <form class="curation"
                  hx-patch="/devices/{{ .Device.ID }}"
                  hx-target="#device-panel"
                  hx-swap="outerHTML">
                <div class="curation__fields">
                    <label class="stack">
                        <span class="eyebrow">Label</span>
                        <input class="input" name="label" value="{{ .Device.Label }}"
                               placeholder="{{ .Device.Hostname }}" autocomplete="off">
                    </label>
                    <label class="stack">
                        <span class="eyebrow">Group</span>
                        <input class="input" name="group" value="{{ .Device.Group }}"
                               list="device-groups" autocomplete="off">
                    </label>
                    <label class="stack">
                        <span class="eyebrow">Type</span>
                        <select class="input" name="type">
                            <option value="">
                                {{- with classLabel .Device.ClassGuess }}Auto &middot; {{ . }}{{ else }}Auto{{ end -}}
                            </option>
                            {{- range classChoices }}
                            <option value="{{ .Value }}"{{ if eq .Value $.Device.Type }} selected{{ end }}>{{ .Label }}</option>
                            {{- end }}
                        </select>
                    </label>
                </div>

                <label class="stack">
                    <span class="eyebrow">Notes</span>
                    <textarea class="input" name="notes" rows="3"
                              placeholder="Where it is, what it does, why it is here">{{ .Device.Notes }}</textarea>
                </label>

                <label class="check">
                    <input type="checkbox" name="ignored" value="1"{{ if .Device.Ignored }} checked{{ end }}>
                    <span>Leave this device out of the inventory</span>
                </label>

                <div class="curation__actions">
                    <button type="submit" class="btn">Save</button>
                    {{- if .Saved }}
                    <p class="saved" role="status">Saved.</p>
                    {{- end }}
                </div>

                <datalist id="device-groups">
                    {{- range .Groups }}
                    <option value="{{ . }}"></option>
                    {{- end }}
                </datalist>
            </form>

            <p class="note">These are yours. No sweep or plugin writes them, so they
                survive the device changing address or being identified later.</p>
        </section>
    </div>
</div>
{{- if .Saved }}
{{- /*
    Two things this swap does not cover sit outside it, and both are stale the
    moment a label changes: the heading, which the layout draws in the topbar,
    and the log, which is further down the page. Sent out of band so they
    update too -- otherwise the page would go on calling the device by its old
    name, and the history would sit there saying nothing had happened.
*/}}
<h1 id="page-title" hx-swap-oob="true">{{ .Device.Name }}</h1>
<div id="device-history" hx-swap-oob="true">
    {{- template "partial/activity" .Events }}
</div>
{{- end }}
{{ end }}
