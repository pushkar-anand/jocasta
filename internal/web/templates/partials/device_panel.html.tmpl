{{- /*
    The identity of the device and its curation form, next to each other. So a
    saved label updates the field, and the facts that show it.
*/ -}}
{{ define "partial/device-panel" }}
<div id="device-panel">
    <div class="glance">
        {{- with .Device }}
        <section class="card panel">
            <div class="block__head">
                <h2 class="section">Identity</h2>
                <span class="chip">{{ if eq (print .IdentitySource) "MAC" }}by hardware address{{ else }}by IP address{{ end }}</span>
            </div>

            <dl class="facts">
                <div><dt>Hardware</dt><dd class="mono">{{ dash .MAC }}</dd></div>
                <div><dt>Vendor</dt><dd>{{ dash .Vendor }}</dd></div>
                <div><dt>Hostname</dt><dd>{{ dash .Hostname }}</dd></div>
                <div><dt>Type</dt><dd>
                    {{- with .Class }}
                    <span class="cell">
                        {{- with classIcon . }}
                        <svg class="devicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ . }}</svg>
                        {{- end }}
                        {{ classLabel . }}
                        {{- if not $.Device.Type }}
                        <span class="chip chip--quiet">auto{{ with confidence $.Device.ClassConfidence }} &middot; {{ . }}{{ end }}</span>
                        {{- end }}
                    </span>
                    {{- else }}<span class="dim">{{ dash "" }}</span>{{ end }}
                </dd></div>
                <div><dt>Group</dt><dd>{{ dash .Group }}</dd></div>
                <div><dt>First seen</dt><dd class="dim">{{ stamp .FirstSeen "" }}</dd></div>
                <div><dt>Last seen</dt><dd class="dim">{{ stamp .LastSeen "" }}</dd></div>
                {{- /* The start time, where stamp gives an age. A person reads
                       a run of sightings by its start. A device that was
                       present before presence tracking has no start. */}}
                <div><dt>Presence</dt><dd>
                    {{- if .Online }}Seen recently{{ if not .PresentSince.IsZero }} since {{ since .PresentSince }}{{ end }}
                    {{- else if .LastSeen.IsZero }}Not seen
                    {{- else }}Quiet since {{ since .LastSeen }}{{ end -}}
                </dd></div>
                <div><dt>Last checked</dt><dd class="dim">{{ stamp $.LastChecked "" }}</dd></div>
            </dl>

            {{- if .Randomised }}
            <p class="note">The device made up this hardware address itself. So it names
                no vendor, and it can change the next time the device connects.</p>
            {{- end }}

            {{- /* The user set the type, and the classifier would say something
                   different. This is worth a line. Its guess is where "auto"
                   would go if the user cleared the override. */}}
            {{- if and .Type .ClassGuess (ne .ClassGuess .Class) }}
            <p class="note">Auto-detected as
                {{ classLabel .ClassGuess }}{{ with confidence .ClassConfidence }} ({{ . }} confidence){{ end }}.</p>
            {{- end }}
        </section>
        {{- end }}

        <section class="card panel">
            <h2 class="section">What you call it</h2>

            {{- /* The facts come first, for every reader: the current name of
                   the device. A writer opens the form from here. A save closes
                   it again, and these values show the change. */}}
            <dl class="facts">
                <div><dt>Label</dt><dd>{{ with .Device.Label }}{{ . }}{{ else }}<span class="dim">&mdash;</span>{{ end }}</dd></div>
                <div><dt>Group</dt><dd>{{ with .Device.Group }}{{ . }}{{ else }}<span class="dim">&mdash;</span>{{ end }}</dd></div>
                {{- /* Notes take the width of the card, under the label and
                       group. Long notes are cut at 8 lines with "Show all". The
                       ports table uses the same details switch. */}}
                <div class="facts__wide fold">
                    <dt>Notes</dt>
                    {{- with .Device.Notes }}
                    {{- if gt (len .) 800 }}
                    <dd class="notes notes--long">{{ . }}</dd>
                    <dd><details class="fold__toggle">
                        <summary><span class="fold__closed">Show all notes</span><span class="fold__open">Show fewer notes</span></summary>
                    </details></dd>
                    {{- else }}
                    <dd class="notes">{{ . }}</dd>
                    {{- end }}
                    {{- else }}
                    <dd><span class="dim">&mdash;</span></dd>
                    {{- end }}
                </div>
                {{- if .Device.Ignored }}
                <div><dt>Ignored</dt><dd>Yes, hidden from lists</dd></div>
                {{- end }}
                {{- if .Device.Watched }}
                <div><dt>Watched</dt><dd>Yes, told when it goes quiet or comes back</dd></div>
                {{- end }}
            </dl>

            {{- if not .Role.CanWrite }}
            <p class="note">Your account is read-only, so it cannot change these.</p>
            {{- else }}
            {{- if .Saved }}
            {{- /* tabindex, so the swap can put focus on the outcome. It is
                   next to the summary, because its form is now closed. */}}
            <p class="saved" role="status" tabindex="-1">{{ or .Notice "Details saved." }}</p>
            {{- end }}
            {{- /* The watch is a separate action. The edit form replaces every
                   field in it. The watch is not one of them. */}}
            <form class="watch"
                  hx-post="/devices/{{ .Device.ID }}/watch"
                  hx-target="#device-panel"
                  hx-swap="outerHTML">
                {{- if .Device.Watched }}
                <input type="hidden" name="watched" value="0">
                <button type="submit" class="btn btn--quiet">Stop watching</button>
                {{- else }}
                <input type="hidden" name="watched" value="1">
                <button type="submit" class="btn btn--quiet">Watch</button>
                <span class="dim">Get told when it goes quiet or comes back.</span>
                {{- end }}
            </form>
            <details class="editpanel">
                <summary>Edit details</summary>
                <form class="curation"
                      hx-patch="/devices/{{ .Device.ID }}"
                      hx-target="#device-panel"
                      hx-swap="outerHTML">
                    <div class="curation__fields">
                        <label class="stack">
                            <span class="eyebrow">Label</span>
                            <input class="input" name="label" value="{{ .Device.Label }}"
                                   placeholder="{{ .Device.Hostname }}" autocomplete="off">
                        </label>
                        <label class="stack">
                            <span class="eyebrow">Group</span>
                            <input class="input" name="group" value="{{ .Device.Group }}"
                                   list="device-groups" autocomplete="off">
                        </label>
                        <label class="stack">
                            <span class="eyebrow">Type</span>
                            <select class="input" name="type">
                                <option value="">
                                    {{- with classLabel .Device.ClassGuess }}Auto &middot; {{ . }}{{ else }}Auto{{ end -}}
                                </option>
                                {{- range classChoices }}
                                <option value="{{ .Value }}"{{ if eq .Value $.Device.Type }} selected{{ end }}>{{ .Label }}</option>
                                {{- end }}
                            </select>
                        </label>
                    </div>

                    <label class="stack">
                        <span class="eyebrow">Notes</span>
                        <textarea class="input" name="notes" rows="3"
                                  placeholder="For example, upstairs hallway">{{ .Device.Notes }}</textarea>
                    </label>

                    <label class="check">
                        <input type="checkbox" name="ignored" value="1"{{ if .Device.Ignored }} checked{{ end }}>
                        <span>Ignore this device (hide it from lists)</span>
                    </label>

                    <div class="curation__actions">
                        <button type="submit" class="btn">Save</button>
                    </div>

                    <datalist id="device-groups">
                        {{- range .Groups }}
                        <option value="{{ . }}"></option>
                        {{- end }}
                    </datalist>
                </form>
            </details>

            <p class="note">Scans never change these. They stay with the device when its
                address changes.</p>
            {{- end }}
        </section>
    </div>
</div>
{{- if .Saved }}
{{- /*
    Two things are outside this swap, and both become old when a label changes.
    One is the heading, which the layout draws in the topbar. The other is the
    log, further down the page. They go out of band, so they also update. If
    not, the page would still show the old name of the device, and the history
    would show no change.
*/}}
<h1 id="page-title" title="{{ .Device.Name }}" hx-swap-oob="true">{{ .Device.Name }}</h1>
<div id="device-history" hx-swap-oob="true">
    {{- template "partial/activity" .Events }}
</div>
{{- end }}
{{ end }}
