{{- /*
    The same row as a form. The identity cell stays as it was (dot, class icon,
    name). So the edited row is still clearly the row that a person picked. Only
    the rest becomes the form.

    Two fields are worth an edit from a list. The others go as hidden inputs,
    because an edit applies every field of the user. A field that the form
    leaves out would be cleared. The page of the device can edit the whole set.
*/ -}}
{{ define "partial/device-row-form" }}
<tr id="device-row-{{ .Device.ID }}" class="editing">
    <td class="editing__id">
        <span class="cell">
            {{ dot .Device.LastSeen }}
            {{- with classIcon .Device.Class }}
            <svg class="devicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ . }}</svg>
            {{- end }}
            <span class="strong">{{ .Device.Name }}</span>
        </span>
    </td>
    <td colspan="6">
        <form class="inline-form"
              hx-patch="/devices/{{ .Device.ID }}/row"
              hx-target="#device-row-{{ .Device.ID }}"
              hx-swap="outerHTML">
            <label class="stack">
                <span class="eyebrow">Label</span>
                <input class="input" name="label" value="{{ .Device.Label }}"
                       placeholder="{{ .Device.Name }}" autocomplete="off" autofocus>
            </label>
            <label class="stack">
                <span class="eyebrow">Group</span>
                <input class="input" name="group" value="{{ .Device.Group }}"
                       list="known-groups" autocomplete="off">
            </label>

            <input type="hidden" name="notes" value="{{ .Device.Notes }}">
            <input type="hidden" name="type" value="{{ .Device.Type }}">
            {{- if .Device.Ignored }}
            <input type="hidden" name="ignored" value="1">
            {{- end }}

            <span class="inline-form__actions">
                <button type="submit" class="btn btn--sm">Save</button>
                <button type="button" class="btn btn--quiet btn--sm"
                        hx-get="/devices/{{ .Device.ID }}/row"
                        hx-target="#device-row-{{ .Device.ID }}"
                        hx-swap="outerHTML">Cancel</button>
            </span>
        </form>
    </td>
</tr>
{{ end }}
