{{- /*
    The network as a tree, top down: the internet, the router, each switch
    and access point on the port it hangs from, and the devices on each port
    or Wi-Fi network. Laid out by topomap.Place; colours come from classes in
    style.css. netmap.js zooms, pans, searches and selects, and lights the
    path to a selected device through each element's data-path keys.
*/ -}}
{{ define "partial/topology-body" }}
{{- with .Layout }}
<div class="card netmap topo">
    <div class="netmap__zoom" role="group" aria-label="Zoom">
        <button type="button" class="netmap__zoom-btn" data-netmap-zoom="in" aria-label="Zoom in">+</button>
        <button type="button" class="netmap__zoom-btn" data-netmap-zoom="out" aria-label="Zoom out">&minus;</button>
        <button type="button" class="netmap__zoom-btn" data-netmap-zoom="reset" aria-label="Show the whole network">&#x2922;</button>
    </div>

    <aside class="netmap__legend" aria-label="Legend">
        {{- with $.VLANs }}
        <ul class="netmap__keys">
            {{- range . }}
            <li class="netmap__key netmap__tone-{{ segtone .Tone }}" tabindex="0">
                <span class="netmap__swatch" aria-hidden="true"></span>
                <span class="netmap__key-label">{{ .Label }}</span>
                <span class="netmap__key-count">{{ .Devices }}</span>
            </li>
            {{- end }}
        </ul>
        {{- end }}
        <ul class="netmap__keys netmap__keys--lines">
            <li class="netmap__key">
                <svg class="topo__key-line" viewBox="0 0 36 10" aria-hidden="true"><path class="topo__edge topo__edge--trunk" d="M 2 5 L 34 5"/></svg>
                <span class="netmap__key-label">Trunk</span>
            </li>
            <li class="netmap__key">
                <svg class="topo__key-line" viewBox="0 0 36 10" aria-hidden="true"><path class="topo__edge topo__edge--vlan" d="M 2 5 L 34 5"/></svg>
                <span class="netmap__key-label">One VLAN</span>
            </li>
            <li class="netmap__key">
                <svg class="topo__key-line" viewBox="0 0 36 10" aria-hidden="true"><path class="topo__edge topo__edge--wifi" d="M 2 5 L 34 5"/></svg>
                <span class="netmap__key-label">Wi-Fi</span>
            </li>
        </ul>
        <ul class="netmap__keys netmap__keys--lines">
            <li class="netmap__key">
                <svg class="topo__key-box" viewBox="0 0 22 14" aria-hidden="true"><rect class="topo__frame topo__frame--read" x="1.5" y="1.5" width="19" height="11" rx="3"/></svg>
                <span class="netmap__key-label">Read by Jocasta</span>
            </li>
            <li class="netmap__key">
                <svg class="topo__key-box" viewBox="0 0 22 14" aria-hidden="true"><rect class="topo__frame topo__frame--seen" x="1.5" y="1.5" width="19" height="11" rx="3"/></svg>
                <span class="netmap__key-label">Announced itself</span>
            </li>
            <li class="netmap__key">
                <svg class="topo__key-box" viewBox="0 0 22 14" aria-hidden="true"><rect class="topo__frame topo__frame--unnamed" x="1.5" y="1.5" width="19" height="11" rx="3"/></svg>
                <span class="netmap__key-label">Inferred</span>
            </li>
        </ul>
    </aside>

    <svg class="netmap__svg" viewBox="0 0 {{ .Width }} {{ .Height }}"
         data-width="{{ .Width }}" data-height="{{ .Height }}" data-focus-span="1200"
         preserveAspectRatio="xMidYMid meet" role="img"
         aria-label="The network from the internet down: the router, then each switch and access point on its port, then the devices on each port or Wi-Fi network">

        <g class="topo__edges">
            {{- range .Edges }}
            <path class="topo__edge topo__edge--{{ .Kind }}" d="{{ .Path }}" data-path="{{ .On }}">{{ with .Title }}<title>{{ . }}</title>{{ end }}</path>
            {{- end }}
        </g>

        <g class="topo__internet">
            <circle class="topo__cloud" cx="{{ .Internet.X }}" cy="{{ .Internet.Y }}" r="20"><title>Internet</title></circle>
            <text class="topo__cloud-label" x="{{ .Internet.X }}" y="{{ .Internet.Y }}" dx="28" dy="4">Internet</text>
        </g>

        <g class="topo__ports">
            {{- range .Edges }}
            {{- if .Label }}
            <text class="topo__port" x="{{ .LabelAt.X }}" y="{{ .LabelAt.Y }}" data-path="{{ .On }}">{{ .Label }}</text>
            {{- end }}
            {{- end }}
        </g>

        <g class="topo__boxes">
            {{- range .Boxes }}
            {{- if .DeviceID }}
            <a class="topo__box topo__box--{{ .Kind }}{{ if not .Online }} topo__box--offline{{ end }}" href="/devices/{{ .DeviceID }}"
               data-key="{{ .Key }}" data-name="{{ .Name }} {{ .Board }}" data-path="{{ .On }}">
            {{- else }}
            <g class="topo__box topo__box--{{ .Kind }}" data-key="{{ .Key }}" data-name="{{ .Label }} {{ .Board }}" data-path="{{ .On }}">
            {{- end }}
                <rect class="topo__frame topo__frame--{{ .Kind }}" x="{{ .X }}" y="{{ .Y }}" width="{{ .W }}" height="{{ .H }}" rx="8"><title>{{ .Label }}{{ with .Board }} &middot; {{ . }}{{ end }}</title></rect>
                <text class="topo__name" x="{{ .X }}" y="{{ .Y }}" dx="12" dy="{{ if .Board }}20{{ else }}29{{ end }}">{{ .Label }}</text>
                {{- if .Board }}
                <text class="topo__board" x="{{ .X }}" y="{{ .Y }}" dx="12" dy="37">{{ .Board }}</text>
                {{- end }}
            {{- if .DeviceID }}
            </a>
            {{- else }}
            </g>
            {{- end }}
            {{- end }}
        </g>

        <g class="topo__groups">
            {{- range .Groups }}
            <g class="topo__group" data-path="{{ .On }}">
                <text class="topo__group-title{{ if ge .Tone 0 }} netmap__tone-{{ segtone .Tone }}{{ end }}" x="{{ .X }}" y="{{ .Y }}" dx="2" dy="16">{{ .Title }}</text>
                {{- range .Chips }}
                <a class="netmap__dev topo__chip{{ if ge .Tone 0 }} netmap__tone-{{ segtone .Tone }}{{ else }} topo__chip--untagged{{ end }}{{ if not .Online }} topo__chip--offline{{ end }}{{ if not .Current }} topo__chip--past{{ end }}"
                   href="/devices/{{ .DeviceID }}" data-key="{{ .Key }}" data-name="{{ .Name }}">
                    <rect class="topo__chip-bg" x="{{ .X }}" y="{{ .Y }}" width="190" height="22" rx="5"><title>{{ .Title }}</title></rect>
                    <circle class="topo__chip-dot" cx="{{ .X }}" cy="{{ .Y }}" r="4" transform="translate(11 11)"/>
                    <text class="topo__chip-label" x="{{ .X }}" y="{{ .Y }}" dx="22" dy="15">{{ .Label }}</text>
                    {{- if .Aside }}
                    <text class="topo__chip-aside" x="{{ .AsideAt.X }}" y="{{ .AsideAt.Y }}" dy="15" text-anchor="end">{{ .Aside }}</text>
                    {{- end }}
                </a>
                {{- end }}
            </g>
            {{- end }}
        </g>
    </svg>
</div>
{{- end }}

{{- with .Tree.Unplaced }}
<section class="topo__unplaced" aria-labelledby="topo-unplaced">
    <h3 class="section" id="topo-unplaced">Not placed</h3>
    <ul class="topo__unplaced-list">
        {{- range . }}
        <li><a href="/devices/{{ .DeviceID }}">{{ .Name }}</a></li>
        {{- end }}
    </ul>
</section>
{{- end }}
{{ end }}
