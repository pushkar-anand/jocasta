{{- /*
    Takes a trafficSection. It shows who one device talked to over a period. The
    data comes from the hourly totals of the traffic exports of the router.

    The filter form, the tabs and the tries switch all fetch this fragment and
    swap it whole. The search box has an id, so htmx keeps focus in it across
    the swap. search.js keeps the typed text. Without htmx, they are plain links
    and a form that submits to the device page. That page renders the same
    section.

    The figures at the top cover the whole period, before any filter. Under them
    is one tab for each network segment and one for the internet. On a local
    tab, each peer is one row for all of its services. Unknown addresses
    collapse by subnet. On the Internet tab, each organisation is one row that
    opens to its addresses.

    Each row shows who opened its connections: this device (→) or the peer (←).
    The direction filter keeps one side. Connections with no data are hidden
    unless the user asks for them. They then show on the row of the peer that
    they went to.
*/ -}}
{{ define "partial/device-traffic" }}
<div id="device-traffic" class="traffic">
    {{- if not .Recorded }}
    <p class="dim">Traffic collection is not set up. So it is unknown who this device talks to.</p>
    {{- else }}
    <form id="traffic-filters" class="filters" role="search" action="/devices/{{ .DeviceID }}#traffic" method="get"
          hx-get="/devices/{{ .DeviceID }}/traffic"
          hx-target="#device-traffic"
          hx-swap="outerHTML"
          hx-sync="this:replace"
          hx-trigger="filter, submit" data-live>
        <input type="hidden" name="tab" value="{{ .Tab.Key }}">

        <label class="field field--search">
            <span class="visually-hidden">Find</span>
            <svg class="field__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
            </svg>
            <input id="traffic-q" type="search" name="q" value="{{ .Filter.Query }}"
                   placeholder="Search name, address or organisation" autocomplete="off">
        </label>

        <label class="field">
            <span class="visually-hidden">Period</span>
            <select id="traffic-window" name="traffic">
                {{- range .Windows }}
                <option value="{{ .Key }}"{{ if eq .Key $.Window.Key }} selected{{ end }}>Last {{ .Label }}</option>
                {{- end }}
            </select>
        </label>

        {{- if .Services }}
        <label class="field">
            <span class="visually-hidden">Service</span>
            <select id="traffic-service" name="service">
                <option value="">Any service</option>
                {{- range .Services }}
                <option value="{{ .Key }}"{{ if eq .Key $.Filter.Service }} selected{{ end }}>{{ .Label }}</option>
                {{- end }}
            </select>
        </label>
        {{- end }}

        <label class="field">
            <span class="visually-hidden">Direction</span>
            <select id="traffic-dir" name="dir">
                <option value="">Any direction</option>
                <option value="out"{{ if eq .Filter.Direction "out" }} selected{{ end }}>Opened by this device</option>
                <option value="in"{{ if eq .Filter.Direction "in" }} selected{{ end }}>Opened by them</option>
            </select>
        </label>

        {{- if .HasAttempts }}
        <label class="field field--check">
            <input id="traffic-tried" type="checkbox" name="tried" value="1"{{ if .Filter.Tried }} checked{{ end }}>
            <span>Show tries with no data</span>
        </label>
        {{- end }}

        <noscript><button type="submit" class="btn">Apply</button></noscript>
    </form>

    {{- with .Probing }}
    <div class="notice notice--warn" role="note">
        <p><strong>This device probed your network.</strong>
            {{- if .SweptAddresses }} In one hour it tried {{ .Peers }} addresses on your network{{ if .SweptPorts }}, and up to {{ .MaxPorts }} ports on one of them{{ end }}.
            {{- else }} In one hour it tried {{ .MaxPorts }} ports on one address.{{ end }}
            {{ if .Answered }}{{ count .Answered }} of {{ count .Attempts }} tries got an answer.{{ else }}None of its {{ count .Attempts }} tries got an answer.{{ end }}{{ with .Ports }} Ports tried include {{ portList . }}.{{ end }}
            Last seen {{ stamp .LastHour "" }}.</p>
    </div>
    {{- end }}

    {{- range .Probed }}
    <div class="notice" role="note">
        <p><strong>{{ if .Outside }}The internet tried this router's outside address.{{ else }}The internet tried this device.{{ end }}</strong>
            {{ count .Peers }} {{ if eq .Peers 1 }}address{{ else }}addresses{{ end }} from {{ .Orgs }} {{ if eq .Orgs 1 }}organisation{{ else }}organisations{{ end }}
            made {{ count .Attempts }} {{ if eq .Attempts 1 }}try{{ else }}tries{{ end }} with no data, and {{ if .Answered }}{{ count .Answered }}{{ else }}none{{ end }} got an answer.{{ with .Ports }} Ports tried include {{ portList . }}.{{ end }}
            Last seen {{ stamp .LastHour "" }}.</p>
    </div>
    {{- end }}

    {{- if .Empty }}
    <p class="dim">No traffic recorded for this device in the last {{ .Window.Label }}.</p>
    {{- else }}

    {{- with .Summary }}
    <div class="card traffic__summary">
        <dl class="stats">
            <div><dd>{{ bytes .Received }}</dd><dt>Received</dt></div>
            <div><dd>{{ bytes .Sent }}</dd><dt>Sent</dt></div>
            <div><dd>{{ .Local }}</dd><dt>On your network</dt></div>
            <div><dd>{{ .Orgs }}</dd><dt>{{ if eq .Orgs 1 }}Organisation{{ else }}Organisations{{ end }} on the internet</dt></div>
            {{- if .FromInternet }}
            <div><dd>{{ count .FromInternet }}</dd><dt>Opened from the internet</dt></div>
            {{- end }}
            {{- if .Tries }}
            <div{{ if not $.Probing }} class="stat--quiet"{{ end }}><dd>{{ count .Tries }}</dd><dt>Tries with no data</dt></div>
            {{- end }}
        </dl>
        {{- if .Tries }}
        <p class="traffic__tried dim">Sent to {{ .TriedPeers }} {{ if eq .TriedPeers 1 }}peer{{ else }}peers{{ end }}. {{ if .Answered }}{{ count .Answered }}{{ else }}None{{ end }} answered.
            <a href="{{ $.TriedPath }}#traffic"
               hx-get="{{ $.TriedFragment }}"
               hx-target="#device-traffic"
               hx-swap="outerHTML">{{ if $.Filter.Tried }}Hide them{{ else }}Show them{{ end }}</a></p>
        {{- end }}
    </div>
    {{- end }}

    <nav class="tabs" aria-label="Where it talks to">
        {{- range .Tabs }}
        <a class="tabs__tab{{ if .Empty }} tabs__tab--empty{{ end }}"
           href="{{ $.TabPath .Key }}#traffic"
           hx-get="{{ $.TabFragment .Key }}"
           hx-target="#device-traffic"
           hx-swap="outerHTML"
           {{- if eq .Key $.Tab.Key }} aria-current="page"{{ end }}>
            {{- .Label }}{{ with .VLAN }} <span class="tabs__vlan">VLAN {{ . }}</span>{{ end }}
            <span class="tabs__count">{{ .Count }}</span></a>
        {{- end }}
    </nav>

    {{- with .Tab }}
    {{- if .Empty }}
    {{- if $.Filter.Active }}
    <p class="dim">Nothing {{ if .IsInternet }}on the internet{{ else if .IsBroadcasts }}it broadcast{{ else }}on {{ .Label }}{{ end }} in the last {{ $.Window.Label }} matches.
        <a href="{{ $.ClearPath }}#traffic"
           hx-get="{{ $.ClearFragment }}"
           hx-target="#device-traffic"
           hx-swap="outerHTML">Clear filters</a></p>
    {{- else }}
    <p class="dim">This device exchanged nothing {{ if .IsInternet }}with the internet{{ else }}on {{ .Label }}{{ end }} in the last {{ $.Window.Label }}{{ if and $.HasAttempts (not $.Filter.Tried) }}. To see connections it tried, tick &ldquo;Show tries with no data&rdquo;{{ end }}.</p>
    {{- end }}

    {{- else if .IsBroadcasts }}
    <div class="card card--table">
        <div class="scroller">
            <table class="stacks">
                <thead>
                <tr>
                    <th scope="col">What</th>
                    <th scope="col">Sent to</th>
                    <th scope="col" class="num">Packets</th>
                    <th scope="col" class="num">Sent</th>
                    <th scope="col">Last seen</th>
                </tr>
                </thead>
                <tbody>
                {{- range .Broadcasts }}
                <tr>
                    <td>{{ .What }}</td>
                    <td data-label="Sent to">{{ .To }} <span class="mono dim">{{ .Dst }}{{ with .Port }}:{{ . }}{{ end }}</span></td>
                    <td data-label="Packets" class="num">{{ count .Packets }}</td>
                    <td data-label="Sent" class="num">{{ bytes .Bytes }}</td>
                    <td data-label="Last seen" class="dim">{{ stamp .LastHour "" }}</td>
                </tr>
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
    <p class="note">Packets to a whole subnet or multicast group. Most are the device that announces itself, or looks for others.
        Jocasta guesses the names from the port and group.</p>

    {{- else if .IsInternet }}
    <div class="card card--table">
        <div class="scroller">
            <table class="stacks">
                <thead>
                <tr>
                    <th scope="col">Organisation</th>
                    <th scope="col" class="num">Connections</th>
                    <th scope="col" class="num">Sent</th>
                    <th scope="col" class="num">Received</th>
                    <th scope="col">Last seen</th>
                </tr>
                </thead>
                <tbody>
                {{- range .Internet }}
                <tr>
                    <td>
                        <details class="peers">
                            <summary>
                                <span class="strong" title="{{ .Name }}">{{ .Short }}</span>
                                <span class="dim">{{ len .Peers }} {{ if eq (len .Peers) 1 }}address{{ else }}addresses{{ end }}{{ with .LookedUp }} &middot; {{ . }}{{ end }}</span>
                                {{- if .Tries }} <span class="chip chip--warn">{{ count .Tries }} tried, {{ count .Answered }} answered</span>{{ end }}
                            </summary>
                            <ul class="peers__list">
                                {{- range .Peers.Head }}
                                <li>{{ template "partial/traffic-peer" . }}</li>
                                {{- end }}
                                {{- with .Peers.Rest }}
                                <li class="dim">and {{ count . }} more</li>
                                {{- end }}
                            </ul>
                        </details>
                    </td>
                    <td data-label="Connections" class="num">{{ template "partial/traffic-conns" . }}</td>
                    <td data-label="Sent" class="num">{{ template "partial/traffic-bytes" .Sent }}</td>
                    <td data-label="Received" class="num">{{ template "partial/traffic-bytes" .Received }}</td>
                    <td data-label="Last seen" class="dim">{{ stamp .LastHour "" }}</td>
                </tr>
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>

    {{- else }}
    <div class="card card--table">
        <div class="scroller">
            <table class="stacks">
                <thead>
                <tr>
                    <th scope="col">Talks to</th>
                    <th scope="col">Services</th>
                    <th scope="col" class="num">Connections</th>
                    <th scope="col" class="num">Sent</th>
                    <th scope="col" class="num">Received</th>
                    <th scope="col">Last seen</th>
                </tr>
                </thead>
                <tbody>
                {{- range .Local }}
                {{- if .Group }}
                {{- with .Group }}
                <tr>
                    <td colspan="2">
                        <details class="peers">
                            <summary>
                                <span class="strong">{{ len .Peers }} {{ if eq (len .Peers) 1 }}address{{ else }}addresses{{ end }} in <span class="mono">{{ .Prefix }}</span></span>
                                <span class="dim">not in your inventory</span>
                                {{- if .Tries }} <span class="chip chip--warn">{{ count .Tries }} tried, {{ count .Answered }} answered</span>{{ end }}
                            </summary>
                            <ul class="peers__list">
                                {{- range .Peers.Head }}
                                <li>{{ template "partial/traffic-peer" . }}</li>
                                {{- end }}
                                {{- with .Peers.Rest }}
                                <li class="dim">and {{ count . }} more</li>
                                {{- end }}
                            </ul>
                        </details>
                    </td>
                    <td data-label="Connections" class="num">{{ template "partial/traffic-conns" . }}</td>
                    <td data-label="Sent" class="num">{{ template "partial/traffic-bytes" .Sent }}</td>
                    <td data-label="Received" class="num">{{ template "partial/traffic-bytes" .Received }}</td>
                    <td data-label="Last seen" class="dim">{{ stamp .LastHour "" }}</td>
                </tr>
                {{- end }}
                {{- else }}
                {{- with .Peer }}
                <tr>
                    <td>
                        {{- if .DeviceID }}
                        <a href="/devices/{{ .DeviceID }}">{{ .DeviceName }}</a>
                        {{- else }}
                        <span class="mono">{{ .IP }}</span>
                        {{- template "partial/traffic-peer-name" . }}
                        {{- end }}
                    </td>
                    <td data-label="Services">
                        {{- if .Services }}{{ template "partial/traffic-services" . }}{{ end }}
                        {{- if .Tried }}
                        <span class="traffic__tried"><span class="chip chip--warn">no data</span>
                            {{ .TriedSummary }} &middot; {{ count .Tries }} tried, {{ count .Answered }} answered</span>
                        {{- end }}
                    </td>
                    <td data-label="Connections" class="num">{{ template "partial/traffic-conns" . }}</td>
                    <td data-label="Sent" class="num">{{ template "partial/traffic-bytes" .Sent }}</td>
                    <td data-label="Received" class="num">{{ template "partial/traffic-bytes" .Received }}</td>
                    <td data-label="Last seen" class="dim">{{ stamp .LastHour "" }}</td>
                </tr>
                {{- end }}
                {{- end }}
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
    {{- end }}
    {{- end }}

    <p class="note">Hourly totals from your router. Names come from DNS. {{ .Attribution }}.</p>
    {{- end }}
    {{- end }}
</div>
{{ end }}

{{- /* A byte count, or a dash if no data moved. A dash marks a peer that the
       device only tried. */ -}}
{{ define "partial/traffic-bytes" }}{{ if . }}{{ bytes . }}{{ else }}<span class="dim">&ndash;</span>{{ end }}{{ end }}

{{- /* The name beside the address of a peer. This is the name that the device
       looked up for it, with all such names on hover. If there is none, it is
       the reverse DNS name. */ -}}
{{ define "partial/traffic-peer-name" }}
{{- with .ShownName }} <span class="dim"{{ with $.AllLookedUp }} title="{{ . }}"{{ end }}>{{ . }}</span>{{ end }}
{{- end }}

{{- /* One address inside a collapsed group. It shows the address, its DNS name,
       its services, the data that moved and the tries to it. */ -}}
{{ define "partial/traffic-peer" }}
<span class="mono">{{ .IP }}</span>
{{- template "partial/traffic-peer-name" . }}
<span class="peers__detail">
    {{- if .Services }}
    {{ .ServiceSummary }} &middot; {{ bytes .Sent }} sent &middot; {{ bytes .Received }} received
    {{- if or .Outgoing .Incoming }} &middot; {{ template "partial/traffic-conns" . }}{{ end }}
    {{- end }}
    {{- if .Tried }}
    {{ if .Services }}&middot; {{ end }}tried {{ .TriedSummary }} &middot; {{ count .Tries }} tried, {{ count .Answered }} answered
    {{- end }}
</span>
{{ end }}

{{- /* The services of a peer. It names the busiest one. If there is more than
       one, it also shows each service. */ -}}
{{ define "partial/traffic-services" }}
{{- if gt (len .Services) 1 -}}
<details class="peers">
    <summary>{{ .ServiceSummary }}</summary>
    <ul class="peers__list">
        {{- range .Services }}
        <li>{{ $.ServiceLabel . }}
            <span class="peers__detail">{{ bytes .Sent }} sent &middot; {{ bytes .Received }} received
                {{- if or .Connections .ConnectionsIn }} &middot;
                {{- with .Connections }} &rarr; {{ count . }}{{ end }}
                {{- with .ConnectionsIn }} &larr; {{ count . }}{{ end }}{{ end }}</span></li>
        {{- end }}
    </ul>
</details>
{{- else -}}
{{ .ServiceSummary }}
{{- end -}}
{{ end }}

{{- /* Who opened the connections of a row: this device (→) or the peer (←),
       with the counts. Takes any value with Outgoing and Incoming counts. */ -}}
{{ define "partial/traffic-conns" -}}
{{- if or .Outgoing .Incoming -}}
<span class="conns">
    {{- with .Outgoing }}<span title="This device opened {{ count . }} {{ if eq . 1 }}connection{{ else }}connections{{ end }}">&rarr; {{ count . }}</span>{{ end }}
    {{- if and .Outgoing .Incoming }} &middot; {{ end }}
    {{- with .Incoming }}<span title="They opened {{ count . }} {{ if eq . 1 }}connection{{ else }}connections{{ end }} to this device">&larr; {{ count . }}</span>{{ end -}}
</span>
{{- else -}}
<span class="dim">&ndash;</span>
{{- end -}}
{{- end }}
