{{- /*
    Takes a trafficSection. Who one device talked to over a period, from the
    hourly totals the router's traffic exports add up to.

    The filter form, the tabs and the tries switch all fetch this fragment and
    swap it whole; htmx keeps focus in the search box across the swap because
    it has an id. Without htmx they are plain links and a form submitting to
    the device page, which renders the same section.

    The figures at the top are the whole period, before any filter. Under them
    one tab per network segment, and one for the internet: on a local tab each
    peer is one row whatever services it was reached on, with unknown
    addresses collapsed by subnet; on the Internet tab each organisation is one
    row that opens to the addresses behind it. Connections that carried no data
    are left out unless asked for, and then sit on the row of the peer they
    went to.
*/ -}}
{{ define "partial/device-traffic" }}
<div id="device-traffic" class="traffic">
    {{- if not .Recorded }}
    <p class="dim">Traffic collection is not set up, so who this device talks to is unknown.</p>
    {{- else }}
    <form class="filters" role="search" action="/devices/{{ .DeviceID }}#traffic" method="get"
          hx-get="/devices/{{ .DeviceID }}/traffic"
          hx-target="#device-traffic"
          hx-swap="outerHTML"
          hx-sync="this:replace"
          hx-trigger="input changed delay:300ms, change, submit">
        <input type="hidden" name="tab" value="{{ .Tab.Key }}">

        <label class="field field--search">
            <span class="visually-hidden">Find</span>
            <svg class="field__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
            </svg>
            <input id="traffic-q" type="search" name="q" value="{{ .Filter.Query }}"
                   placeholder="name, address, organisation" autocomplete="off">
        </label>

        <label class="field">
            <span class="visually-hidden">Period</span>
            <select id="traffic-window" name="traffic">
                {{- range .Windows }}
                <option value="{{ .Key }}"{{ if eq .Key $.Window.Key }} selected{{ end }}>Last {{ .Label }}</option>
                {{- end }}
            </select>
        </label>

        {{- if .Services }}
        <label class="field">
            <span class="visually-hidden">Service</span>
            <select id="traffic-service" name="service">
                <option value="">Any service</option>
                {{- range .Services }}
                <option value="{{ .Key }}"{{ if eq .Key $.Filter.Service }} selected{{ end }}>{{ .Label }}</option>
                {{- end }}
            </select>
        </label>
        {{- end }}

        {{- if .HasAttempts }}
        <label class="field field--check">
            <input id="traffic-tried" type="checkbox" name="tried" value="1"{{ if .Filter.Tried }} checked{{ end }}>
            <span>Show tries with no data</span>
        </label>
        {{- end }}

        <noscript><button type="submit" class="btn">Apply</button></noscript>
    </form>

    {{- with .Probing }}
    <div class="notice notice--warn" role="note">
        <p><strong>This device probed your network.</strong>
            {{- if .SweptAddresses }} In one hour it tried {{ .Peers }} addresses on your network{{ if .SweptPorts }}, and up to {{ .MaxPorts }} ports on one of them{{ end }}.
            {{- else }} In one hour it tried {{ .MaxPorts }} ports on one address.{{ end }}
            {{ count .Answered }} of {{ count .Attempts }} tries were answered{{ with .Ports }}; ports tried include {{ portList . }}{{ end }}.
            Last seen doing it {{ stamp .LastHour "" }}.</p>
    </div>
    {{- end }}

    {{- if .Empty }}
    <p class="dim">No traffic recorded for this device in the last {{ .Window.Label }}.</p>
    {{- else }}

    {{- with .Summary }}
    <div class="card traffic__summary">
        <dl class="stats">
            <div><dd>{{ bytes .Received }}</dd><dt>Received</dt></div>
            <div><dd>{{ bytes .Sent }}</dd><dt>Sent</dt></div>
            <div><dd>{{ .Local }}</dd><dt>On your network</dt></div>
            <div><dd>{{ .Orgs }}</dd><dt>{{ if eq .Orgs 1 }}Organisation{{ else }}Organisations{{ end }} on the internet</dt></div>
            {{- if .FromInternet }}
            <div><dd>{{ count .FromInternet }}</dd><dt>Opened from the internet</dt></div>
            {{- end }}
            {{- if .Tries }}
            <div{{ if not $.Probing }} class="stat--quiet"{{ end }}><dd>{{ count .Tries }}</dd><dt>Tries with no data</dt></div>
            {{- end }}
        </dl>
        {{- if .Tries }}
        <p class="traffic__tried dim">{{ count .Answered }} of those answered, across {{ .TriedPeers }} {{ if eq .TriedPeers 1 }}peer{{ else }}peers{{ end }}.
            <a href="{{ $.TriedPath }}#traffic"
               hx-get="{{ $.TriedFragment }}"
               hx-target="#device-traffic"
               hx-swap="outerHTML">{{ if $.Filter.Tried }}Hide them{{ else }}Show them{{ end }}</a></p>
        {{- end }}
    </div>
    {{- end }}

    <nav class="tabs" aria-label="Where it talks to">
        {{- range .Tabs }}
        <a class="tabs__tab{{ if .Empty }} tabs__tab--empty{{ end }}"
           href="{{ $.TabPath .Key }}#traffic"
           hx-get="{{ $.TabFragment .Key }}"
           hx-target="#device-traffic"
           hx-swap="outerHTML"
           {{- if eq .Key $.Tab.Key }} aria-current="page"{{ end }}>
            {{- .Label }}{{ with .VLAN }} <span class="tabs__vlan">VLAN {{ . }}</span>{{ end }}
            <span class="tabs__count">{{ .Count }}</span></a>
        {{- end }}
    </nav>

    {{- with .Tab }}
    {{- if .Empty }}
    {{- if $.Filter.Active }}
    <p class="dim">Nothing {{ if .IsInternet }}on the internet{{ else if .IsBroadcasts }}it broadcast{{ else }}on {{ .Label }}{{ end }} in the last {{ $.Window.Label }} matches.
        <a href="{{ $.ClearPath }}#traffic"
           hx-get="{{ $.ClearFragment }}"
           hx-target="#device-traffic"
           hx-swap="outerHTML">Clear filters</a></p>
    {{- else }}
    <p class="dim">This device exchanged nothing {{ if .IsInternet }}with the internet{{ else }}on {{ .Label }}{{ end }} in the last {{ $.Window.Label }}{{ if and $.HasAttempts (not $.Filter.Tried) }}; it may have tried, which &ldquo;Show tries with no data&rdquo; adds{{ end }}.</p>
    {{- end }}

    {{- else if .IsBroadcasts }}
    <div class="card card--table">
        <div class="scroller">
            <table>
                <thead>
                <tr>
                    <th scope="col">What</th>
                    <th scope="col">Sent to</th>
                    <th scope="col" class="num">Packets</th>
                    <th scope="col" class="num">Sent</th>
                    <th scope="col">Last seen</th>
                </tr>
                </thead>
                <tbody>
                {{- range .Broadcasts }}
                <tr>
                    <td>{{ .What }}</td>
                    <td>{{ .To }} <span class="mono dim">{{ .Dst }}{{ with .Port }}:{{ . }}{{ end }}</span></td>
                    <td class="num">{{ count .Packets }}</td>
                    <td class="num">{{ bytes .Bytes }}</td>
                    <td class="dim">{{ stamp .LastHour "" }}</td>
                </tr>
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
    <p class="note">What this device sent to everyone rather than to one host:
        discovery protocols announcing it, or looking for others. Names are
        guessed from the port and group, not read from the packets.</p>

    {{- else if .IsInternet }}
    <div class="card card--table">
        <div class="scroller">
            <table>
                <thead>
                <tr>
                    <th scope="col">Organisation</th>
                    <th scope="col" class="num">Sent</th>
                    <th scope="col" class="num">Received</th>
                    <th scope="col">Last seen</th>
                </tr>
                </thead>
                <tbody>
                {{- range .Internet }}
                <tr>
                    <td>
                        <details class="peers">
                            <summary>
                                <span class="strong" title="{{ .Name }}">{{ .Short }}</span>
                                <span class="dim">{{ len .Peers }} {{ if eq (len .Peers) 1 }}address{{ else }}addresses{{ end }}</span>
                                {{- if .Incoming }} {{ template "partial/traffic-incoming" .Incoming }}{{ end }}
                                {{- if .Tries }} <span class="chip chip--warn">{{ count .Tries }} tried, {{ count .Answered }} answered</span>{{ end }}
                            </summary>
                            <ul class="peers__list">
                                {{- range .Peers.Head }}
                                <li>{{ template "partial/traffic-peer" . }}</li>
                                {{- end }}
                                {{- with .Peers.Rest }}
                                <li class="dim">and {{ count . }} more</li>
                                {{- end }}
                            </ul>
                        </details>
                    </td>
                    <td class="num">{{ template "partial/traffic-bytes" .Sent }}</td>
                    <td class="num">{{ template "partial/traffic-bytes" .Received }}</td>
                    <td class="dim">{{ stamp .LastHour "" }}</td>
                </tr>
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>

    {{- else }}
    <div class="card card--table">
        <div class="scroller">
            <table>
                <thead>
                <tr>
                    <th scope="col">Talks to</th>
                    <th scope="col">Services</th>
                    <th scope="col" class="num">Sent</th>
                    <th scope="col" class="num">Received</th>
                    <th scope="col">Last seen</th>
                </tr>
                </thead>
                <tbody>
                {{- range .Local }}
                {{- if .Group }}
                {{- with .Group }}
                <tr>
                    <td colspan="2">
                        <details class="peers">
                            <summary>
                                <span class="strong">{{ len .Peers }} addresses in <span class="mono">{{ .Prefix }}</span></span>
                                <span class="dim">not in your inventory</span>
                                {{- if .Tries }} <span class="chip chip--warn">{{ count .Tries }} tried, {{ count .Answered }} answered</span>{{ end }}
                            </summary>
                            <ul class="peers__list">
                                {{- range .Peers.Head }}
                                <li>{{ template "partial/traffic-peer" . }}</li>
                                {{- end }}
                                {{- with .Peers.Rest }}
                                <li class="dim">and {{ count . }} more</li>
                                {{- end }}
                            </ul>
                        </details>
                    </td>
                    <td class="num">{{ template "partial/traffic-bytes" .Sent }}</td>
                    <td class="num">{{ template "partial/traffic-bytes" .Received }}</td>
                    <td class="dim">{{ stamp .LastHour "" }}</td>
                </tr>
                {{- end }}
                {{- else }}
                {{- with .Peer }}
                <tr>
                    <td>
                        {{- if .DeviceID }}
                        <a href="/devices/{{ .DeviceID }}">{{ .DeviceName }}</a>
                        {{- else }}
                        <span class="mono">{{ .IP }}</span>
                        {{- with .Name }} <span class="dim">{{ . }}</span>{{ end }}
                        {{- end }}
                        {{- if .Incoming }} {{ template "partial/traffic-incoming" .Incoming }}{{ end }}
                    </td>
                    <td>
                        {{- if .Services }}{{ template "partial/traffic-services" . }}{{ end }}
                        {{- if .Tried }}
                        <span class="traffic__tried"><span class="chip chip--warn">no data</span>
                            {{ .TriedSummary }} &middot; {{ count .Tries }} tried, {{ count .Answered }} answered</span>
                        {{- end }}
                    </td>
                    <td class="num">{{ template "partial/traffic-bytes" .Sent }}</td>
                    <td class="num">{{ template "partial/traffic-bytes" .Received }}</td>
                    <td class="dim">{{ stamp .LastHour "" }}</td>
                </tr>
                {{- end }}
                {{- end }}
                {{- end }}
                </tbody>
            </table>
        </div>
    </div>
    {{- end }}
    {{- end }}

    <p class="note">Hourly totals from your router. Names come from DNS and from
        IP to ASN data by <a href="https://db-ip.com">DB-IP</a>.</p>
    {{- end }}
    {{- end }}
</div>
{{ end }}

{{- /* A byte count, or a dash when nothing moved: a peer that was only tried. */ -}}
{{ define "partial/traffic-bytes" }}{{ if . }}{{ bytes . }}{{ else }}<span class="dim">&ndash;</span>{{ end }}{{ end }}

{{- /* One address inside a collapsed group: the address, its DNS name, what it
       was reached on and how much moved, and what was tried there. */ -}}
{{ define "partial/traffic-peer" }}
<span class="mono">{{ .IP }}</span>
{{- with .Name }} <span class="dim">{{ . }}</span>{{ end }}
{{- if .Incoming }} {{ template "partial/traffic-incoming" .Incoming }}{{ end }}
<span class="peers__detail">
    {{- if .Services }}
    {{ .ServiceSummary }} &middot; {{ bytes .Sent }} sent &middot; {{ bytes .Received }} received
    {{- end }}
    {{- if .Tried }}
    {{ if .Services }}&middot; {{ end }}tried {{ .TriedSummary }} &middot; {{ count .Tries }} tried, {{ count .Answered }} answered
    {{- end }}
</span>
{{ end }}

{{- /* A peer's services: the busiest by name, and a breakdown per service when
       there is more than one. */ -}}
{{ define "partial/traffic-services" }}
{{- if gt (len .Services) 1 -}}
<details class="peers">
    <summary>{{ .ServiceSummary }}</summary>
    <ul class="peers__list">
        {{- range .Services }}
        <li>{{ $.ServiceLabel . }}
            <span class="peers__detail">{{ bytes .Sent }} sent &middot; {{ bytes .Received }} received
                {{- with .ConnectionsIn }} &middot; opened {{ count . }} {{ if eq . 1 }}time{{ else }}times{{ end }} by them{{ end }}</span></li>
        {{- end }}
    </ul>
</details>
{{- else -}}
{{ .ServiceSummary }}
{{- end -}}
{{ end }}

{{- /* Marks a peer that opened connections on the device, rather than the other
       way round: something reached in. */ -}}
{{ define "partial/traffic-incoming" }}<span class="chip chip--brand chip--label" title="Opened {{ count . }} {{ if eq . 1 }}connection{{ else }}connections{{ end }} to this device">incoming</span>{{ end }}
