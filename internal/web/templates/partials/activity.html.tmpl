{{- /* Takes a slice of events. */ -}}
{{ define "partial/activity" }}
{{- if . }}
<ul class="activity">
    {{- range . }}
    <li class="{{ decay .At }}">
        <time datetime="{{ .At.Format "2006-01-02T15:04:05Z07:00" }}">{{ ago .At }}</time>
        <span class="kind">{{ event .Kind }}</span>
        <span class="name">{{ dash .DeviceName }}</span>
        {{- with change . }}<span class="dim">{{ . }}</span>{{ end }}
    </li>
    {{- end }}
</ul>
{{- else }}
<p class="dim">Nothing recorded yet.</p>
{{- end }}
{{ end }}
