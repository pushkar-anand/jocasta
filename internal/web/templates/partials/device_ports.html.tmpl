{{- /*
    Takes a slice of port rows. Each is a port a scan found a device listening
    on, or listening on before the service stopped, or a port the device
    advertises a service on over DNS-SD. Only a port seen open or advertised
    is ever recorded, so a short list here means a small surface.

    Past the tenth row the rest fold away behind "Show all", a native details
    element after the table whose open state the stylesheet reads, so no
    script is needed and a browser without :has() shows every row.
*/ -}}
{{ define "partial/device-ports" }}
<div class="card card--table fold">
    <div class="scroller">
        <table class="stacks">
            <thead>
            <tr>
                <th scope="col">Port</th>
                <th scope="col">Service</th>
                <th scope="col">Advertised as</th>
                <th scope="col">State</th>
                <th scope="col">First seen</th>
            </tr>
            </thead>
            <tbody>
            {{- range $n, $port := . }}
            <tr{{ if ge $n 10 }} class="fold__row"{{ end }}>
                <td>
                    {{- if .Number }}
                    <span class="mono strong">{{ .Number }}{{ if .UDP }}/udp{{ end }}</span>
                    {{- else }}
                    <span class="dim">&mdash;</span>
                    {{- end }}
                </td>
                <td data-label="Service">
                    {{- if .Service }}
                    {{ .Service }}
                    {{- else }}
                    <span class="dim">&mdash;</span>
                    {{- end }}
                </td>
                <td data-label="Advertised as">
                    {{- range $i, $a := .Advertised }}
                    {{- if $i }}<br>{{ end }}
                    {{- if $a.Name }}{{ $a.Name }}{{ else }}<span class="mono dim">{{ $a.Type }}</span>{{ end }}
                    {{- if or $a.Instance $a.Model }}
                    <br><span class="dim">{{ $a.Instance }}{{ if and $a.Instance $a.Model }} &middot; {{ end }}{{ $a.Model }}</span>
                    {{- end }}
                    {{- else }}
                    <span class="dim">&mdash;</span>
                    {{- end }}
                </td>
                <td data-label="State">
                    {{- if not .Scanned }}
                    <span class="chip">advertised</span>
                    {{- else if .Open }}
                    <span class="chip chip--ok">open</span>
                    {{- else }}
                    <span class="chip">closed {{ stamp .ChangedAt "" }}</span>
                    {{- end }}
                </td>
                <td data-label="First seen" class="dim">{{ stamp .FirstSeen "" }}</td>
            </tr>
            {{- end }}
            </tbody>
        </table>
    </div>
    {{- if gt (len .) 10 }}
    <details class="fold__toggle">
        <summary><span class="fold__closed">Show all {{ len . }} ports</span><span class="fold__open">Show fewer ports</span></summary>
    </details>
    {{- end }}
</div>
{{ end }}
