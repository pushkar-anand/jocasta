{{- /*
    Takes a slice of ports. The TCP ports a scan has found a device listening
    on, and the ones it used to answer on before the service stopped. Only a
    port seen open is ever recorded, so a short list here means a small surface,
    not a shallow scan.
*/ -}}
{{ define "partial/device-ports" }}
<div class="card card--table">
    <div class="scroller">
        <table>
            <thead>
            <tr>
                <th scope="col">Port</th>
                <th scope="col">Service</th>
                <th scope="col">State</th>
                <th scope="col">First seen</th>
            </tr>
            </thead>
            <tbody>
            {{- range . }}
            <tr>
                <td><span class="mono strong">{{ .Number }}</span></td>
                <td>
                    {{- if .Service }}
                    {{ .Service }}
                    {{- else }}
                    <span class="dim">&mdash;</span>
                    {{- end }}
                </td>
                <td>
                    {{- if .Open }}
                    <span class="chip chip--ok">open</span>
                    {{- else }}
                    <span class="chip">closed {{ ago .ChangedAt }}</span>
                    {{- end }}
                </td>
                <td class="dim">{{ ago .FirstSeen }}</td>
            </tr>
            {{- end }}
            </tbody>
        </table>
    </div>
</div>
{{ end }}
