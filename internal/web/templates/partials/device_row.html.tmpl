{{- /* One device. Takes the device itself, and replaces itself when edited. */ -}}
{{ define "partial/device-row" }}
<tr id="device-row-{{ .ID }}">
    <td>
        <span class="cell">
            <span class="dot {{ decay .LastSeen }}"></span>
            <a class="strong" href="/devices/{{ .ID }}">{{ .Name }}</a>
        </span>
    </td>
    <td class="mono">{{ addrs .Current }}</td>
    <td class="mono dim">{{ dash .MAC }}{{ if .Randomised }} <span class="chip chip--warn">randomised</span>{{ end }}</td>
    <td class="dim">{{ dash .Vendor }}</td>
    <td class="dim">{{ dash .Group }}</td>
    <td class="dim">{{ ago .LastSeen }}</td>
    <td class="cell--end">
        <button type="button" class="btn btn--quiet btn--sm"
                hx-get="/devices/{{ .ID }}/edit"
                hx-target="#device-row-{{ .ID }}"
                hx-swap="outerHTML">Edit</button>
    </td>
</tr>
{{ end }}
