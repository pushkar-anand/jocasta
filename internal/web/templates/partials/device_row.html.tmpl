{{- /* One device. Takes the device itself, and replaces itself when edited. */ -}}
{{ define "partial/device-row" }}
<tr id="device-row-{{ .ID }}">
    <td>
        <span class="cell">
            <span class="dot {{ decay .LastSeen }}"></span>
            {{- with classIcon .Class }}
            <svg class="devicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" role="img"
                 aria-label="{{ classLabel $.Class }}"><title>{{ classLabel $.Class }}</title>{{ . }}</svg>
            {{- end }}
            <a class="strong" href="/devices/{{ .ID }}">{{ .Name }}</a>
        </span>
    </td>
    <td class="mono" data-label="Addresses">{{ addrs .Current }}</td>
    <td data-label="Network">
        {{- if .Networks }}
        <span class="cell cell--wrap">
            {{- range .Networks }}
            <a class="mono" href="/networks/{{ .ID }}">{{ .CIDR }}</a>
            {{- if .VLAN }}<span class="chip chip--brand">VLAN {{ .VLAN }}</span>{{ end }}
            {{- end }}
        </span>
        {{- else }}
        <span class="dim">&mdash;</span>
        {{- end }}
    </td>
    <td class="dim" data-label="Group">{{ dash .Group }}</td>
    <td class="dim" data-label="Last seen">{{ ago .LastSeen }}</td>
    <td class="cell--end">
        {{- if .CanWrite }}
        <button type="button" class="btn btn--quiet btn--sm"
                hx-get="/devices/{{ .ID }}/edit"
                hx-target="#device-row-{{ .ID }}"
                hx-swap="outerHTML">Edit</button>
        {{- end }}
    </td>
</tr>
{{ end }}
