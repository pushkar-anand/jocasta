{{- /*
    What each source says about the device, beside the one name the device row
    settled on. A source that was outranked still had a reason for what it
    claimed, and the disagreements are the point: a router holding a bound lease
    for something the sweep has not reached in days is two sources telling the
    truth about different things.
*/ -}}
{{ define "partial/device-sources" }}
<div class="card card--table">
    <div class="scroller">
        <table class="stacks">
            <thead>
            <tr>
                <th scope="col">Source</th>
                <th scope="col">Calls it</th>
                <th scope="col">Details</th>
                <th scope="col">First heard</th>
                <th scope="col">Last heard</th>
            </tr>
            </thead>
            <tbody>
            {{- range . }}
            <tr>
                <td>
                    <span class="cell">
                        {{ dot .LastSeen }}
                        <span class="mono strong">{{ .Source }}</span>
                    </span>
                </td>
                <td data-label="Calls it">
                    {{- if .Hostname }}
                    {{ .Hostname }}
                    <span class="chip">{{ standing .HostnameSource }}</span>
                    {{- else }}
                    <span class="dim">no name</span>
                    {{- end }}
                </td>
                <td data-label="Details">
                    {{- if .Detail }}
                    <dl class="detail">
                        {{- range .Detail }}
                        <div><dt title="{{ .Key }}">{{ sourcekey .Key }}</dt><dd class="mono">{{ .Value }}</dd></div>
                        {{- end }}
                    </dl>
                    {{- else }}
                    <span class="dim">&mdash;</span>
                    {{- end }}
                </td>
                <td data-label="First heard" class="dim">{{ stamp .FirstSeen "" }}</td>
                <td data-label="Last heard" class="dim">{{ stamp .LastSeen "" }}</td>
            </tr>
            {{- end }}
            </tbody>
        </table>
    </div>
</div>
{{ end }}
