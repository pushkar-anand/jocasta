{{- /*
    What each source says about the device, next to the one name of the device
    row. A source with a lower rank still had a reason for its claim. The
    disagreements are the purpose of this section. A router can have a bound
    lease for a device that the sweep did not reach for days. Then two sources
    tell the truth about different things.

    A source claims for each address. So a device with several addresses has a
    row for each. The rows of a source stay together, and its name shows once.
*/ -}}
{{ define "partial/device-sources" }}
<div class="card card--table">
    <div class="scroller">
        <table class="stacks">
            <thead>
            <tr>
                <th scope="col">Source</th>
                <th scope="col">Address</th>
                <th scope="col">Calls it</th>
                <th scope="col">Details</th>
                <th scope="col">First heard</th>
                <th scope="col">Last heard</th>
            </tr>
            </thead>
            <tbody>
            {{- $source := "" }}
            {{- range . }}
            <tr>
                <td>
                    {{- if ne .Source $source }}
                    <span class="cell">
                        {{ dot .LastSeen }}
                        <span class="mono strong">{{ .Source }}</span>
                    </span>
                    {{- else }}
                    <span class="visually-hidden">{{ .Source }}</span>
                    {{- end }}
                </td>
                <td data-label="Address" class="mono">{{ .Address }}</td>
                <td data-label="Calls it">
                    {{- if .Hostname }}
                    {{ .Hostname }}
                    <span class="chip">{{ standing .HostnameSource }}</span>
                    {{- else }}
                    <span class="dim">no name</span>
                    {{- end }}
                </td>
                <td data-label="Details">
                    {{- if .Detail }}
                    <dl class="detail">
                        {{- range .Detail }}
                        <div><dt title="{{ .Key }}">{{ sourcekey .Key }}</dt><dd class="mono">{{ .Value }}</dd></div>
                        {{- end }}
                    </dl>
                    {{- else }}
                    <span class="dim">&mdash;</span>
                    {{- end }}
                </td>
                <td data-label="First heard" class="dim">{{ stamp .FirstSeen "" }}</td>
                <td data-label="Last heard" class="dim">{{ stamp .LastSeen "" }}</td>
            </tr>
            {{- $source = .Source }}
            {{- end }}
            </tbody>
        </table>
    </div>
</div>
{{ end }}
